---
import Poster from './Poster.astro';
const { items, id, cta = 'Hire Me', ctaFor = '', ctaLine = 'Want a film like this?' } = Astro.props as { items: any[]; id: string; cta?: string; ctaFor?: string; ctaLine?: string };
---
<div class="car" data-car>
  <button class="arrow prev" aria-label="Previous films" data-dir="-1">‹</button>
  <div class="track" id={id} tabindex="0">
    {items.map((f) => <div class="slide"><Poster item={f} /></div>)}
    <div class="slide">
      <a href={`/?for=${ctaFor}#hire`} class="end preset" data-for={ctaFor}>
        <span class="end-line">{ctaLine}</span>
        <span class="btn">{cta}</span>
      </a>
    </div>
  </div>
  <button class="arrow next" aria-label="Next films" data-dir="1">›</button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-car]').forEach((car) => {
    const track = car.querySelector('.track') as HTMLElement;
    const prev = car.querySelector('.prev') as HTMLButtonElement, next = car.querySelector('.next') as HTMLButtonElement;
    const sync = () => { prev.disabled = track.scrollLeft < 8; next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8; };
    car.querySelectorAll<HTMLButtonElement>('.arrow').forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.85, behavior: 'smooth' })));
    track.addEventListener('scroll', sync, { passive: true }); addEventListener('resize', sync); sync();
  });
</script>
<style>
  .car { position: relative; }
  .track { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(220px, 21vw, 290px); gap: 1.2rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad); padding: 0 var(--pad) .5rem; scrollbar-width: none; }
  .track::-webkit-scrollbar { display: none; }
  .slide { scroll-snap-align: start; min-width: 0; }
  .slide > :global(*) { width: 100%; }
  @media (max-width: 640px) { .track { grid-auto-columns: 62vw; gap: .8rem; } }
  .end { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1rem; text-align: center; aspect-ratio: 1 / 1.414; border-radius: 14px; border: 1px solid #333; background: #0d0d0d; padding: 1.2rem; transition: border-color .2s; }
  .end:hover { border-color: #fff; }
  .end-line { font-size: 1.3rem; font-weight: 700; line-height: 1.2; }
  .arrow { position: absolute; top: calc(50% - 2.4rem); transform: translateY(-50%); z-index: 3; width: 48px; height: 48px; border-radius: 50%; border: 0; background: #fff; color: #000; font-size: 1.8rem; line-height: 1; cursor: pointer; box-shadow: 0 4px 18px rgba(0,0,0,.6); padding-bottom: 4px; transition: opacity .2s; }
  .prev { left: .6rem; } .next { right: .6rem; }
  .arrow:disabled { opacity: 0; pointer-events: none; }
  @media (hover: none) { .arrow { display: none; } }
</style>
