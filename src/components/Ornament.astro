---
const { width = 120, class: cls = '' } = Astro.props as { width?: number; class?: string };
---
<svg class={`ornament ${cls}`} width={width} height={width * 0.25} viewBox="0 0 160 40" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
    <path d="M80 20 C70 20 62 12 52 12 C42 12 38 20 30 20 C22 20 18 15 10 18" />
    <path d="M80 20 C90 20 98 12 108 12 C118 12 122 20 130 20 C138 20 142 15 150 18" />
    <path d="M52 12 C50 6 44 5 41 8" /><path d="M108 12 C110 6 116 5 119 8" />
    <path d="M30 20 C28 26 22 28 19 25" /><path d="M130 20 C132 26 138 28 141 25" />
    <path d="M80 20 C76 14 76 8 80 3 C84 8 84 14 80 20 Z" />
    <path d="M80 20 C78 26 78 31 80 36" />
  </g>
  <circle cx="80" cy="20" r="1.6" fill="currentColor" />
</svg>
<style>.ornament { display: block; color: var(--rule); }</style>
