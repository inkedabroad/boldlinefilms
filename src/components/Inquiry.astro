---
import site from '../data/site.json';
const types = [['convention','Convention coverage'],['artist','Artist or shop film'],['business','Philadelphia business promo'],['brand','Branded skit'],['other','Something else']];
---
<form name="inquiry" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="company_site" class="form" id="inquiry-form" novalidate>
  <input type="hidden" name="form-name" value="inquiry" />
  <input type="hidden" name="from_project" id="from_project" />
  <p class="hp"><label>Leave this empty <input name="company_site" tabindex="-1" autocomplete="off" /></label></p>

  <div class="row">
    <label class="field">Name<input name="name" required autocomplete="name" maxlength="120" /></label>
    <label class="field">Email<input type="email" name="email" required autocomplete="email" maxlength="160" /></label>
  </div>
  <label class="field">Project type
    <select name="project_type" id="project_type" required>
      <option value="" disabled selected>Choose one</option>
      {types.map(([v, l]) => <option value={v}>{l}</option>)}
    </select>
  </label>
  <label class="field"><span>Business name or Instagram <span class="opt">(optional)</span></span><input name="business" maxlength="200" /></label>

  <div class="conv" data-show="convention" hidden>
    <label class="field">Event city<input name="event_city" id="event_city" maxlength="120" /></label>
    <div class="field">
      <span>Event dates</span>
      <div class="date-row"><input type="date" name="event_start" aria-label="Start date" /><input type="date" name="event_end" aria-label="End date" /></div>
      <label class="inline"><input type="checkbox" name="dates_unconfirmed" value="yes" /> Dates not confirmed yet</label>
    </div>
  </div>

  <label class="field">Tell me about your project
    <textarea name="message" required rows="5" maxlength="4000"></textarea>
  </label>

  <p class="error" id="form-error" role="alert" hidden>Your inquiry did not send. Your details are still here, so please try again, or email {site.email}.</p>
  <button type="submit" class="btn send">Send inquiry</button>
  <p class="mail">Or email me at <a href={`mailto:${site.email}`}>{site.email}</a></p>
</form>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const type = document.getElementById('project_type') as HTMLSelectElement | null;
  const city = document.getElementById('event_city') as HTMLInputElement | null;
  const KEY = 'inquiry-draft';
  function apply() {
    const v = type?.value || '';
    document.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => (el.hidden = el.dataset.show !== v));
    if (city) city.required = v === 'convention';
  }
  type?.addEventListener('change', apply);
  // restore a draft kept after a failed send
  try {
    const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
    if (saved && form) for (const [k, v] of Object.entries(saved)) {
      const el = form.elements.namedItem(k) as any; if (!el || k === 'form-name') continue;
      if (el.type === 'checkbox') el.checked = v === el.value; else el.value = v;
    }
  } catch {}
  const preset = (t?: string, project?: string) => {
    if (type && t && [...type.options].some((o) => o.value === t)) { type.value = t; }
    if (project) (document.getElementById('from_project') as HTMLInputElement).value = project;
    apply();
  };
  const params = new URLSearchParams(location.search);
  preset(params.get('for') || undefined, params.get('project') || undefined);
  document.addEventListener('inquiry:preset', ((e: CustomEvent) => preset(e.detail?.type, e.detail?.project)) as EventListener);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('form-error')!; err.hidden = true;
    form.querySelectorAll('.invalid').forEach((el) => el.classList.remove('invalid'));
    const bad = [...form.querySelectorAll<HTMLInputElement>('input,select,textarea')].filter((el) => !el.closest('[hidden]') && !el.checkValidity());
    if (bad.length) { bad.forEach((el) => el.closest('.field')?.classList.add('invalid')); bad[0].focus(); return; }
    const data = new FormData(form);
    try { sessionStorage.setItem(KEY, JSON.stringify(Object.fromEntries(data as any))); } catch {}
    const btn = form.querySelector('.send') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Sending';
    try {
      const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data as any).toString() });
      if (!res.ok) throw new Error(String(res.status));
      try { sessionStorage.removeItem(KEY); } catch {}
      location.href = '/thanks';
    } catch { err.hidden = false; btn.disabled = false; btn.textContent = 'Send inquiry'; }
  });
</script>

<style>
  .form { display: grid; gap: 1.15rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.15rem; }
  .field { display: grid; gap: .4rem; font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); }
  .opt { font-weight: 400; color: var(--ink-2); }
  [hidden] { display: none !important; }
  .conv { display: grid; gap: 1.15rem; padding: 1rem; border-left: 2px solid var(--red); background: rgba(251,247,237,.6); }
  input, select, textarea { background: var(--paper-2); border: 1px solid #8f846f; border-radius: 0; color: var(--ink); padding: .8rem .9rem; font: 400 17px var(--serif); width: 100%; -webkit-appearance: none; appearance: none; }
  textarea { resize: vertical; min-height: 140px; }
  select { background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%); background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 2.4rem; }
  input:focus, select:focus, textarea:focus { border-color: var(--green); outline: 2px solid var(--green); outline-offset: 0; }
  .invalid input, .invalid select, .invalid textarea { border-color: var(--red); outline: 1px solid var(--red); }
  .invalid::after { content: 'Please fill this in.'; font-weight: 400; font-size: 14px; color: var(--red); }
  .date-row { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: .5rem; }
  .form, .field, .conv, .row > * { min-width: 0; }
  input[type=date] { min-width: 0; font-size: 16px; padding-inline: .6rem; }
  .inline { display: flex; align-items: center; gap: .6rem; font-weight: 400; font-family: var(--serif); font-size: 17px; }
  .inline input { width: 20px; height: 20px; padding: 0; -webkit-appearance: checkbox; appearance: auto; accent-color: var(--green); }
  .error { margin: 0; padding: .8rem 1rem; border: 1px solid var(--red); color: var(--red); background: var(--paper-2); font-family: var(--sans); font-size: 15px; }
  .hp { position: absolute; left: -9999px; }
  .send { justify-self: start; padding: 1rem 2rem; font-size: 16px; }
  .mail { margin: 0; font-family: var(--sans); font-size: 15px; color: var(--ink-2); }
  .mail a { color: var(--ink); font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--red); }
  @media (max-width: 640px) { .row, .date-row { grid-template-columns: 1fr; } .send { justify-self: stretch; } }
</style>
