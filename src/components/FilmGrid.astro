---
import FilmCard from './FilmCard.astro';
import type { Film } from '../data/films';
interface Props { films: Film[]; }
const { films } = Astro.props;
---
<div class="grid">
  {films.map((film, i) => <FilmCard film={film} eager={i < 2} />)}
</div>
<style>
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3rem) clamp(1.1rem, 2.4vw, 2rem); }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: minmax(0, 1fr); max-width: 420px; margin-inline: auto; } }
</style>
