---
const { item } = Astro.props as { item: any };
const vimeo = (v: string) => { const m = v.match(/(\d+)(?:\/([0-9a-f]+))?/); return m ? `https://player.vimeo.com/video/${m[1]}?autoplay=1${m[2] ? `&h=${m[2]}` : ''}` : ''; };
const src = item.youtube ? `https://www.youtube-nocookie.com/embed/${item.youtube}?autoplay=1&rel=0` : vimeo(item.vimeo || '');
const link = item.youtube ? `https://www.youtube.com/watch?v=${item.youtube}` : (item.vimeo ? `https://vimeo.com/${item.vimeo}` : '');
const img = item.poster || item.still || '';
---
<button class="poster" data-src={src} data-link={link} data-title={item.title} aria-label={`Watch ${item.title}`}>
  <div class="art">
    {img && <img src={img} alt="" loading="lazy" decoding="async" />}
    {!item.poster && <div class="overlay"><span class="ot">{item.title}</span><span class="by">A film by Dakota Weik</span></div>}
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
  </div>
  <span class="t">{item.title}</span>
  <span class="s muted">{item.sub}{item.runtime && ` · ${item.runtime}`}</span>
</button>
<style>
  .poster { background: none; border: 0; padding: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; display: grid; gap: .25rem; }
  .art { position: relative; aspect-ratio: 1 / 1.414; border-radius: 14px; overflow: hidden; background: var(--surface); margin-bottom: .55rem; }
  .art img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .poster:hover .art img { transform: scale(1.03); }
  .overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.1rem; background: linear-gradient(transparent 45%, rgba(0,0,0,.85)); }
  .ot { font-weight: 800; text-transform: uppercase; font-size: clamp(.9rem, 3.4vw, 1.25rem); line-height: 1.05; letter-spacing: -.01em; }
  .by { font-size: clamp(.55rem, 2vw, .72rem); letter-spacing: .12em; text-transform: uppercase; margin-top: .4rem; color: #ccc; }
  .play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(.9); width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,.92); color: #000; display: grid; place-items: center; opacity: 0; transition: opacity .25s, transform .25s; }
  .poster:hover .play, .poster:focus-visible .play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  @media (hover: none) { .play { opacity: .9; width: 44px; height: 44px; } }
  .t { font-weight: 600; font-size: .98rem; line-height: 1.3; }
  .s { font-size: .85rem; }
</style>
