---
interface Props { film: any; size?: 'large' | 'normal'; }
const { film, size = 'normal' } = Astro.props;
const href = `/work/${film.slug}`;
---
<a href={href} class:list={['tile', size]}>
  <div class="frame">
    {film.poster
      ? <img src={film.poster} alt={`Still from ${film.title}`} loading="lazy" decoding="async" />
      : <div class="titlecard"><span class="display">{film.title}</span></div>}
    <span class="view">View film</span>
  </div>
  <div class="meta">
    <p class="client display">{film.client || film.title}</p>
    <p class="label">{film.client ? `${film.title} · ` : ''}{film.categories[0]} · {film.year}</p>
    <p class="roles muted">{film.roles}</p>
  </div>
</a>

<style>
  .tile { display: block; }
  .meta { padding-top: 1rem; }
  .client { font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  .large .client { font-size: clamp(2rem, 4vw, 3.2rem); }
  .label { margin: .35rem 0 0; }
  .roles { margin: .25rem 0 0; font-size: .85rem; }
  .view {
    position: absolute; right: 1rem; bottom: 1rem; font-size: .7rem; letter-spacing: .18em;
    text-transform: uppercase; padding: .5rem .8rem; background: var(--bg); opacity: 0; transform: translateY(6px);
    transition: opacity .3s, transform .3s;
  }
  .tile:hover .view, .tile:focus-visible .view { opacity: 1; transform: none; }
  .tile:hover img { transform: scale(1.03); }
</style>
