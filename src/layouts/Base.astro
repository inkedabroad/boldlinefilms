---
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '../styles/global.css';
import Ornament from '../components/Ornament.astro';
interface Props { title?: string; description?: string; image?: string; compact?: boolean; }
const {
  title = 'Dakota Weik | Tattoo Ethnographer and Filmmaker',
  description = 'Films for tattoo conventions, artists, independent businesses and brands by Dakota Weik. Based in Philadelphia and available worldwide.',
  image = '/media/stills/mondial-lead.jpg',
  compact = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="theme-color" content="#F5EFE2" />
  <slot name="head" />
</head>
<body>
  <header class:list={['mast', { compact }]}>
    <div class="wrap">
      <Ornament width={compact ? 70 : 110} class="mast-orn" />
      <a href="/" class="mast-name" aria-label="Inked Abroad, home"><span aria-hidden="true">Inked<span class="amp">❧</span>Abroad</span></a>
      <nav aria-label="Main">
        <a href="/#work">Work</a><span aria-hidden="true">·</span><a href="/#about">About</a><span aria-hidden="true">·</span><a href="/#inquire">Inquire</a>
      </nav>
      <hr class="rule-double" />
    </div>
  </header>
  <main><slot /></main>
  <footer class="foot wrap">
    <hr class="rule" />
    <div class="foot-row">
      <p><span class="foot-name">Inked Abroad</span> · Dakota Weik · Philadelphia, Pennsylvania</p>
      <p class="foot-links"><a href="/#work">Work</a><a href="/#inquire">Inquire</a></p>
    </div>
  </footer>
</body>
</html>
<style>
  .mast { text-align: center; padding-top: clamp(14px, 2.4vw, 30px); }
  .mast :global(.mast-orn) { margin: 0 auto clamp(4px, 1vw, 10px); }
  .mast-name { display: inline-block; text-decoration: none; font-family: var(--display); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; line-height: .95; font-size: clamp(30px, 9.8vw, 116px); color: var(--ink); white-space: nowrap; }
  .amp { display: inline-block; font-size: .42em; color: var(--red); vertical-align: .55em; margin: 0 .22em; letter-spacing: 0; text-transform: none; font-family: var(--serif); }
  nav { display: flex; justify-content: center; align-items: center; gap: .9rem; margin: clamp(8px, 1.4vw, 16px) 0 clamp(10px, 1.4vw, 14px); font-family: var(--sans); font-size: 14px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  nav a { text-decoration: none; padding: .35rem .1rem; }
  nav a:hover { color: var(--red); }
  nav span { color: var(--rule); }
  .compact .mast-name { font-size: clamp(30px, 4.4vw, 52px); }
  .compact { padding-top: 12px; }
  .foot { padding-block: 0 2.5rem; margin-top: var(--space); }
  .foot-row { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: baseline; padding-top: 1.2rem; font-family: var(--sans); font-size: 14px; color: var(--ink-2); }
  .foot-row p { margin: 0; }
  .foot-name { font-family: var(--display); font-weight: 600; font-size: 1.35rem; color: var(--ink); text-transform: uppercase; letter-spacing: .06em; }
  .foot-links { display: flex; gap: 1.4rem; }
  .foot-links a { font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--red); }
</style>
