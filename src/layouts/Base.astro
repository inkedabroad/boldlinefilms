---
import '@fontsource/limelight';
import '@fontsource/poiret-one';
import '@fontsource-variable/josefin-sans';
import '../styles/global.css';
import site from '../data/site.json';
interface Props { title?: string; description?: string; }
const {
  title = 'Dakota Weik | Ethnographer and Filmmaker in Philadelphia',
  description = 'Convention films, artist films, short promos and branded comedy by Dakota Weik. Based in Philadelphia and available worldwide.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [{ href: '/#work', label: 'Work' }, { href: '/#services', label: 'Services' }, { href: '/#inquire', label: 'Inquire' }];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/media/dakota.jpg', Astro.site)} />
  <meta name="theme-color" content="#0b0a08" />
  <link rel="preconnect" href="https://i.ytimg.com" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap head-row">
      <a href="/" class="brand display">Dakota Weik</a>
      <nav aria-label="Main"><ul class="nav-links">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></nav>
      <a href="/#inquire" class="btn primary head-cta">Start a project</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
      {nav.map((n) => <a href={n.href} class="display">{n.label}</a>)}
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-foot">
    <div class="wrap foot">
      <div>
        <p class="display foot-name">Dakota Weik</p>
        <p class="muted">Ethnographer and filmmaker<br />Inked Abroad · {site.city}<br />Available worldwide</p>
      </div>
      <ul class="foot-list">
        <li><a href="/#work">Work</a></li><li><a href="/#inquire">Inquire</a></li>
        {site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
        <li><a href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </div>
    <p class="wrap copy muted">© {new Date().getFullYear()} Dakota Weik</p>
  </footer>
  <script>
    const btn = document.querySelector('.menu-btn'); const menu = document.getElementById('mobile-nav');
    const toggle = (open: boolean) => { btn?.setAttribute('aria-expanded', String(open)); if (btn) btn.textContent = open ? 'Close' : 'Menu'; if (menu) menu.hidden = !open; };
    btn?.addEventListener('click', () => toggle(btn.getAttribute('aria-expanded') !== 'true'));
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  </script>
</body>
</html>
<style>
  .skip { position: absolute; left: -999px; } .skip:focus { left: 1rem; top: 1rem; background: var(--gold); color: var(--bg); padding: .5rem 1rem; z-index: 200; }
  .site-head { position: sticky; top: 0; z-index: 50; background: rgba(11,10,8,.9); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(201,164,92,.3); }
  .head-row { display: flex; align-items: center; gap: 2rem; height: 74px; }
  .brand { font-size: 1.6rem; color: var(--gold-2); margin-right: auto; }
  .nav-links { display: flex; gap: 2.4rem; list-style: none; margin: 0; padding: 0; }
  .nav-links a { font-family: var(--deco); font-weight: 700; letter-spacing: .26em; text-transform: uppercase; font-size: .82rem; color: var(--text-2); transition: color .2s; }
  .nav-links a:hover { color: var(--gold-2); }
  .head-cta { padding: .7rem 1.1rem; font-size: .75rem; }
  .menu-btn { display: none; background: none; border: 0; color: var(--gold-2); font: 700 .8rem var(--deco); letter-spacing: .26em; text-transform: uppercase; cursor: pointer; }
  .mobile-nav { position: fixed; inset: 74px 0 0 0; background: var(--bg); padding: 2.5rem var(--pad); display: flex; flex-direction: column; gap: 1.5rem; }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav .display { font-size: 2.8rem; color: var(--gold-2); }
  @media (max-width: 820px) { nav[aria-label="Main"], .head-cta { display: none; } .menu-btn { display: block; } }
  .site-foot { border-top: 1px solid rgba(201,164,92,.3); padding: 3.5rem 0 2rem; }
  .foot { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .foot-name { font-size: 2rem; color: var(--gold-2); margin-bottom: .6rem; }
  .foot p { margin: 0; }
  .foot-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, auto); gap: .5rem 2.5rem; font-family: var(--deco); letter-spacing: .18em; text-transform: uppercase; font-size: .82rem; }
  .foot-list a:hover { color: var(--gold-2); }
  .copy { margin-top: 2.5rem; font-size: .8rem; }
</style>
