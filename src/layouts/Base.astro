---
import '@fontsource/alegreya/400.css';
import '@fontsource/alegreya/400-italic.css';
import '@fontsource/alegreya/500.css';
import '@fontsource/alegreya-sans/400.css';
import '@fontsource/alegreya-sans/500.css';
import '../styles/global.css';
import site from '../data/site.json';
interface Props { title?: string; description?: string; }
const {
  title = 'Dakota Weik | Ethnographer and Filmmaker',
  description = 'Films by Dakota Weik for tattoo conventions, artists, shops and brands. Based in Philadelphia, available worldwide.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [{ href: '/#films', label: 'Films' }, { href: '/#conventions', label: 'Conventions' }, { href: '/#services', label: 'Services' }, { href: '/#about', label: 'About' }];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/media/dakota-hero.jpg', Astro.site)} />
  <meta name="theme-color" content="#000000" />
</head>
<body>
  <header class="top">
    <a href="/" class="brand" aria-label="Dakota Weik home"><img src="/media/inked-abroad-logo.png" alt="Inked Abroad" width="642" height="428" /></a>
    <nav aria-label="Main"><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></nav>
    <a href="/#hire" class="btn top-cta">Hire Me</a>
  </header>
  <main><slot /></main>
  <a href="/#hire" class="float-cta btn">Hire Me</a>
  <footer class="foot wrap">
    <p class="foot-name">Dakota Weik</p>
    <ul>
      {site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
    <p class="muted small">© {new Date().getFullYear()} Inked Abroad · {site.city}</p>
  </footer>
  <script>
    const top = document.querySelector('.top') as HTMLElement;
    const cta = document.querySelector('.float-cta') as HTMLElement;
    const hire = document.getElementById('hire');
    const update = () => {
      top?.classList.toggle('solid', window.scrollY > 40);
      const atForm = hire ? hire.getBoundingClientRect().top < window.innerHeight : false;
      cta?.classList.toggle('show', window.scrollY > window.innerHeight * 0.8 && !atForm);
    };
    addEventListener('scroll', update, { passive: true }); update();
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
<style>
  .top { position: fixed; inset: 0 0 auto 0; z-index: 50; display: flex; align-items: center; gap: 2rem; padding: .9rem var(--pad); transition: background .3s, border-color .3s; border-bottom: 1px solid transparent; }
  .top:global(.solid) { background: rgba(0,0,0,.88); backdrop-filter: blur(8px); border-color: var(--line); }
  .brand img { width: 92px; height: auto; }
  nav { margin-left: auto; }
  nav ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 2.2rem; }
  nav a { font-family: var(--sans); font-size: .78rem; letter-spacing: .24em; text-transform: uppercase; color: #ddd; }
  nav a:hover { color: #fff; }
  .top-cta { padding: .75rem 1.3rem; font-size: .72rem; }
  @media (max-width: 760px) { nav { display: none; } .top-cta { margin-left: auto; } .brand img { width: 78px; } }
  .float-cta { position: fixed; right: 1rem; bottom: 1rem; z-index: 40; opacity: 0; pointer-events: none; transform: translateY(10px); transition: opacity .25s, transform .25s, background .25s, color .25s; }
  .float-cta:global(.show) { opacity: 1; pointer-events: auto; transform: none; }
  @media (min-width: 761px) { .float-cta { display: none; } }
  .foot { border-top: 1px solid var(--line); padding-block: 3rem; text-align: center; }
  .foot-name { font-size: 1.8rem; margin: 0; }
  .foot ul { list-style: none; padding: 0; margin: 1rem 0; display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem 1.8rem; font-family: var(--sans); font-size: .78rem; letter-spacing: .2em; text-transform: uppercase; }
  .foot a:hover { color: #fff; text-decoration: underline; }
  .small { font-size: .85rem; margin: 0; }
</style>
