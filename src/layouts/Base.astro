---
import '@fontsource/rock-salt';
import '@fontsource-variable/inter';
import '../styles/global.css';
import site from '../data/site.json';
interface Props { title?: string; description?: string; }
const {
  title = 'Dakota Weik | Ethnographer and Filmmaker',
  description = 'Films by Dakota Weik for tattoo conventions, artists, shops and brands. Based in Philadelphia, available worldwide.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [{ href: '/#films', label: 'Films' }, { href: '/#conventions', label: 'Conventions' }, { href: '/#services', label: 'Services' }, { href: '/#about', label: 'About' }, { href: '/#hire', label: 'Hire Me' }];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/media/dakota.jpg', Astro.site)} />
  <meta name="theme-color" content="#000000" />
</head>
<body>
  <header class="top">
    <a href="/" class="wordmark">Dakota Weik</a>
    <img src="/media/inked-abroad-logo.png" alt="Inked Abroad" class="logo" width="642" height="428" />
    <nav aria-label="Main"><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></nav>
  </header>
  <main><slot /></main>
  <a href="/#hire" class="float-cta btn">Hire Me</a>
  <footer class="foot wrap">
    <a href="/" class="wordmark small">Dakota Weik</a>
    <ul>
      {site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
    <p class="muted">© {new Date().getFullYear()} Inked Abroad · {site.city}</p>
  </footer>
  <script>
    const cta = document.querySelector('.float-cta') as HTMLElement;
    const hire = document.getElementById('hire');
    const update = () => {
      const past = window.scrollY > 500;
      const atForm = hire ? hire.getBoundingClientRect().top < window.innerHeight : false;
      cta?.classList.toggle('show', past && !atForm);
    };
    addEventListener('scroll', update, { passive: true }); update();
  </script>
</body>
</html>
<style>
  .top { text-align: center; padding: 2.2rem var(--pad) 1rem; }
  .wordmark { font-family: var(--script); font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.3; display: inline-block; }
  .wordmark.small { font-size: 1.4rem; }
  .logo { width: clamp(110px, 14vw, 150px); height: auto; margin: .6rem auto 1.2rem; }
  nav ul { list-style: none; padding: 0; margin: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: .4rem 2rem; }
  nav a { font-size: .95rem; color: #ddd; }
  @media (max-width: 480px) { nav ul { gap: .4rem 1.1rem; } nav a { font-size: .9rem; } }
  nav a:hover { color: #fff; text-decoration: underline; text-underline-offset: 5px; }
  nav li:last-child a { font-weight: 700; color: #fff; }
  .float-cta { position: fixed; right: 1.2rem; bottom: 1.2rem; z-index: 40; box-shadow: 0 6px 24px rgba(0,0,0,.6); opacity: 0; pointer-events: none; transform: translateY(10px); transition: opacity .25s, transform .25s; }
  .float-cta:global(.show) { opacity: 1; pointer-events: auto; transform: none; }
  .foot { border-top: 1px solid var(--line); padding-block: 2.5rem; text-align: center; }
  .foot ul { list-style: none; padding: 0; margin: 1rem 0; display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem 1.6rem; font-size: .92rem; }
  .foot a:hover { text-decoration: underline; }
  .foot p { font-size: .85rem; margin: 0; }
</style>
