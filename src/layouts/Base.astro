---
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/league-gothic';
import '@fontsource/yellowtail';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; compact?: boolean; }
const {
  title = 'Dakota Weik | Tattoo Ethnographer and Filmmaker',
  description = 'Films for tattoo conventions, artists, independent businesses and brands by Dakota Weik. Based in Philadelphia and available worldwide.',
  image = '/media/dakota-hero.jpg',
  compact = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="theme-color" content="#EFE6D0" />
</head>
<body>
  <div class="zigzag" aria-hidden="true"></div>
  <header class:list={['mast', { compact }]}>
    <p class="strap">Films · Philadelphia · Worldwide</p>
    <a href="/" class="mast-name">Inked Abroad</a>
    <div class="band">
      <nav aria-label="Main" class="wrap">
        <a href="/#work">Work</a>
        <a href="/" class="seal" aria-label="Home"><span aria-hidden="true">IA</span></a>
        <a href="/#inquire">Inquire</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="foot">
    <div class="wrap">
      <hr class="rule-double" />
      <p class="foot-line">Work with <span>Inked Abroad</span> and work directly with me</p>
      <div class="foot-row">
        <p>Inked Abroad · Dakota Weik · Philadelphia, Pennsylvania</p>
        <p class="foot-links"><a href="/#work">Work</a><a href="/#about">About</a><a href="/#inquire">Inquire</a></p>
      </div>
    </div>
    <div class="zigzag flip" aria-hidden="true"></div>
  </footer>
</body>
</html>
<style>
  .mast { text-align: center; padding-top: clamp(12px, 2vw, 22px); }
  .strap { font-family: var(--gothic); font-size: clamp(13px, 1.2vw, 16px); letter-spacing: .4em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 .2rem; }
  .mast-name { display: inline-block; text-decoration: none; font-family: var(--gothic); text-transform: uppercase; font-size: clamp(56px, 13vw, 150px); line-height: .9; letter-spacing: .04em; color: var(--brick); text-shadow: 2px 2px 0 var(--paper), 4px 4px 0 rgba(42,37,30,.35); white-space: nowrap; }
  .band { margin-top: clamp(6px, 1vw, 12px); background: repeating-linear-gradient(0deg, rgba(42,37,30,.12) 0 1px, transparent 1px 4px); border-block: 2px solid var(--ink); }
  nav { display: flex; justify-content: center; align-items: center; gap: clamp(1.4rem, 6vw, 4rem); padding-block: .35rem; }
  nav a { font-family: var(--gothic); font-size: clamp(20px, 2vw, 24px); letter-spacing: .22em; text-transform: uppercase; text-decoration: none; color: var(--ink); }
  nav a:hover { color: var(--red); }
  .seal { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: var(--brick); color: var(--paper) !important; border: 2px solid var(--paper); outline: 2px solid var(--brick); font-size: 20px !important; letter-spacing: .05em !important; }
  .compact .mast-name { font-size: clamp(44px, 8vw, 90px); }
  .foot { margin-top: var(--space); }
  .foot-line { text-align: center; font-family: var(--display); font-style: italic; text-transform: uppercase; letter-spacing: .12em; font-size: clamp(15px, 2.2vw, 26px); margin: 1.4rem 0 1rem; }
  .foot-line span { font-style: italic; color: var(--red); font-weight: 700; letter-spacing: .08em; }
  .foot-row { display: flex; justify-content: space-between; gap: .6rem 1.5rem; flex-wrap: wrap; padding: 1rem 0 1.6rem; border-top: 1px solid var(--ink); font-family: var(--gothic); letter-spacing: .14em; text-transform: uppercase; font-size: 16px; }
  .foot-row p { margin: 0; }
  .foot-links { display: flex; gap: 1.4rem; }
  .foot-links a { text-decoration: none; } .foot-links a:hover { color: var(--red); }
  .flip { transform: rotate(180deg); }
</style>
