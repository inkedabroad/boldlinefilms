---
import '@fontsource/alegreya/400.css';
import '@fontsource/alegreya/400-italic.css';
import '@fontsource/alegreya/500.css';
import '@fontsource/alegreya-sans/400.css';
import '@fontsource/alegreya-sans/500.css';
import '../styles/global.css';
import site from '../data/site.json';
interface Props { title?: string; description?: string; image?: string; }
const {
  title = 'Dakota Weik | Tattoo Ethnographer and Filmmaker',
  description = 'Films for tattoo conventions, artists, independent businesses and brands by Dakota Weik. Based in Philadelphia and available worldwide.',
  image = '/media/dakota-hero.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="theme-color" content="#000000" />
  <slot name="head" />
</head>
<body>
  <header class="top">
    <a href="/" class="brand">Dakota Weik</a>
    <nav aria-label="Main"><a href="/#work">Work</a><a href="/#inquire" class="inq">Inquire</a></nav>
  </header>
  <main><slot /></main>
  <a href="/#inquire" class="float-cta btn">Start a project</a>
  <footer class="foot wrap">
    <p class="foot-name">Dakota Weik</p>
    <ul>
      {site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
    <p class="muted small">© {new Date().getFullYear()} Inked Abroad · {site.city}</p>
  </footer>
  <script>
    const cta = document.querySelector('.float-cta') as HTMLElement;
    const update = () => {
      const inq = document.getElementById('inquire');
      const atForm = inq ? inq.getBoundingClientRect().top < window.innerHeight : false;
      cta?.classList.toggle('show', window.scrollY > window.innerHeight * 0.6 && !atForm);
    };
    addEventListener('scroll', update, { passive: true }); update();
  </script>
</body>
</html>
<style>
  .top { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; gap: 1.5rem; height: 56px; padding: 0 var(--pad); background: rgba(0,0,0,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .brand { font-size: 1.3rem; margin-right: auto; }
  nav { display: flex; gap: 1.6rem; align-items: center; }
  nav a { font-family: var(--sans); font-size: .74rem; letter-spacing: .24em; text-transform: uppercase; color: #ccc; }
  nav a:hover { color: #fff; }
  nav .inq { color: #fff; border: 1px solid rgba(255,255,255,.5); padding: .5rem .9rem; }
  nav .inq:hover { background: #fff; color: #000; }
  .float-cta { position: fixed; left: 1rem; right: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 40; text-align: center; opacity: 0; pointer-events: none; transform: translateY(10px); transition: opacity .25s, transform .25s, background .25s, color .25s; }
  .float-cta:global(.show) { opacity: 1; pointer-events: auto; transform: none; }
  @media (min-width: 761px) { .float-cta { display: none; } }
  .foot { border-top: 1px solid var(--line); padding-block: 3rem 5.5rem; text-align: center; }
  .foot-name { font-size: 1.6rem; margin: 0; }
  .foot ul { list-style: none; padding: 0; margin: 1rem 0; display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem 1.8rem; font-family: var(--sans); font-size: .76rem; letter-spacing: .18em; text-transform: uppercase; }
  .foot a:hover { color: #fff; text-decoration: underline; }
  .small { font-size: .85rem; margin: 0; }
  @media (min-width: 761px) { .foot { padding-bottom: 3rem; } }
</style>
