---
import '@fontsource/league-gothic';
import '@fontsource-variable/inter';
import '../styles/global.css';
import site from '../data/site.json';

interface Props { title?: string; description?: string; }
const {
  title = `${site.name} | Commercial Director & Cinematographer in Philadelphia`,
  description = `Commercials, brand stories and cinematic short films by ${site.name}, a Philadelphia based director and cinematographer available for projects nationwide.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  {site.heroImage && <meta property="og:image" content={new URL(site.heroImage, Astro.site)} />}
  <meta name="theme-color" content="#101010" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: site.name,
    jobTitle: site.title, address: { '@type': 'PostalAddress', addressLocality: 'Philadelphia', addressRegion: 'PA', addressCountry: 'US' },
    url: 'https://inkedabroadfilm.com', sameAs: site.socials.map((s) => s.url),
  })} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap head-row">
      <a href="/" class="brand display">{site.name}</a>
      <nav aria-label="Main">
        <ul class="nav-links">
          {nav.map((n) => (
            <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      <a href="/contact" class="btn primary head-cta">Start a project</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
      {nav.map((n) => <a href={n.href} class="display">{n.label}</a>)}
      <a href="/contact" class="btn primary">Start a project</a>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="wrap foot-grid">
      <div>
        <p class="display foot-name">{site.name}</p>
        <p class="muted">{site.title}<br />{site.city}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <ul class="foot-list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <ul class="foot-list">
        {site.socials.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    </div>
    <div class="wrap foot-base muted">© {new Date().getFullYear()} {site.name} · Inked Abroad Film</div>
  </footer>

  <script>
    const btn = document.querySelector('.menu-btn');
    const menu = document.getElementById('mobile-nav');
    btn?.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.textContent = open ? 'Menu' : 'Close';
      if (menu) menu.hidden = open;
      document.body.style.overflow = open ? '' : 'hidden';
    });
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; background: var(--text); color: var(--bg); padding: .5rem 1rem; z-index: 100; }
  .skip:focus { left: 1rem; }
  .site-head { position: sticky; top: 0; z-index: 50; background: rgba(16,16,16,.88); backdrop-filter: blur(8px); border-bottom: 1px solid #1e1e1e; }
  .head-row { display: flex; align-items: center; gap: 2rem; height: 72px; }
  .brand { font-size: 1.75rem; margin-right: auto; }
  .nav-links { display: flex; gap: 2.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-links a { font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--text-2); transition: color .2s; }
  .nav-links a:hover, .nav-links a[aria-current] { color: var(--text); }
  .head-cta { padding: .7rem 1.1rem; }
  .menu-btn { display: none; background: none; border: 0; color: var(--text); font: 600 .78rem var(--body); letter-spacing: .16em; text-transform: uppercase; cursor: pointer; padding: .5rem 0; }
  .mobile-nav { position: fixed; inset: 72px 0 0 0; background: var(--bg); padding: 2rem var(--pad); display: flex; flex-direction: column; gap: 1.25rem; }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav .display { font-size: 3.5rem; }
  .mobile-nav .btn { margin-top: 1rem; text-align: center; }
  @media (max-width: 820px) {
    nav[aria-label="Main"], .head-cta { display: none; }
    .menu-btn { display: block; }
  }
  .site-foot { border-top: 1px solid #1e1e1e; padding: 4rem 0 2rem; margin-top: 2rem; }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; }
  .foot-name { font-size: 2.5rem; }
  .foot-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; font-size: .9rem; color: var(--text-2); }
  .foot-list a:hover { color: var(--text); }
  .foot-base { margin-top: 3rem; font-size: .8rem; }
  @media (max-width: 640px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-grid > div:first-child { grid-column: 1 / -1; } }
</style>
