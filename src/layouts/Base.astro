---
import '@fontsource/alegreya/400.css';
import '@fontsource/alegreya/400-italic.css';
import '@fontsource/alegreya/700.css';
import '@fontsource/alegreya/800.css';
import '@fontsource/im-fell-english/400.css';
import '@fontsource/special-elite/400.css';
import '../styles/site.css';
import { site, nav } from '../data/site';

interface Props { title?: string; description?: string; /** Page supplies its own header and footer. */ bare?: boolean; }
const { title, description = site.tagline, bare = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.roles.join(' and ')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name, jobTitle: site.roles.join(', '),
  url: site.url, email: `mailto:${site.email}`, worksFor: { '@type': 'Organization', name: site.studio },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#F0E8D5" />
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {!bare && (
  <header class="mast wrap">
    <p class="dateline type"><span>{site.studio}</span><span>{site.city}</span></p>
    <hr class="rule-thin" />
    <a href="/" class="plate">{site.name}</a>
    <p class="roles type">{site.roles.join(' / ')}</p>
    <hr class="rule" />
    <nav aria-label="Main">
      <ul>{nav.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    </nav>
    <hr class="rule-thin" />
  </header>
  )}
  <main id="main" class:list={{ wrap: !bare }}><slot /></main>
  {!bare && (
  <footer class="foot wrap">
    <hr class="rule" />
    <p class="type"><span>{site.studio} · {site.name}</span><a href={`mailto:${site.email}`}>{site.email}</a></p>
  </footer>
  )}
</body>
</html>
<style>
  .mast { text-align: center; padding-top: 10px; }
  .dateline { display: flex; justify-content: space-between; gap: 1rem; margin: 0 0 6px; font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .plate { display: block; font-family: var(--plate); font-size: clamp(3.1rem, 13.5vw, 9.5rem); line-height: .95; letter-spacing: -.01em; text-decoration: none; margin: clamp(8px, 1.6vw, 18px) 0 0; white-space: nowrap; }
  .roles { margin: clamp(2px, .6vw, 8px) 0 clamp(10px, 1.6vw, 16px); font-size: clamp(.8rem, 1.5vw, 1.05rem); letter-spacing: .34em; text-transform: uppercase; color: var(--red); }
  nav ul { list-style: none; margin: 0; padding: .55rem 0 .4rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .2rem clamp(.9rem, 3.4vw, 2.6rem); }
  nav a { font-family: var(--type); font-size: clamp(.8rem, 1.2vw, .98rem); letter-spacing: .1em; text-transform: uppercase; text-decoration: none; padding: .3rem 0; display: inline-block; border-bottom: 2px solid transparent; }
  nav a:hover { border-color: var(--ink); }
  nav a[aria-current='page'] { border-color: var(--red); color: var(--red); }
  .foot { margin-top: clamp(3.5rem, 8vw, 6rem); padding-bottom: 2rem; }
  .foot p { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .4rem 1.5rem; margin: 1rem 0 0; font-size: .82rem; letter-spacing: .06em; text-transform: uppercase; }
  .foot a { text-decoration: none; border-bottom: 1px solid var(--red); }
</style>
