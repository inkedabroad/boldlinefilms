---
import Base from '../../layouts/Base.astro';
import services from '../../data/services.json';
const faq = [
  ['How does a project work?', 'We start with a short call about your goals. I send a proposal with the plan, schedule and price. A 50% deposit books your date, then we film and I deliver your edits with one round of revisions.'],
  ['Can I mix packages?', 'Yes. Pick the package that fits and add whatever extras you need. I build every proposal around you.'],
  ['Where do you film?', 'Anywhere around Philadelphia, and anywhere in the world for conventions and bigger projects.'],
  ['Can I use the films in ads?', 'Yes. Every proposal spells out where you can use your films, and paid ad usage is priced in up front.'],
];
---
<Base title="Services & Packages | Dakota Weik, Philadelphia Director & Cinematographer" description="Film packages for tattoo artists, tattoo shops, local businesses and conventions. Projects start at $650.">
  <section class="section wrap">
    <p class="label"><span class="num">01</span>Services</p>
    <h1 class="display h1">Pick your package</h1>
    <p class="intro">Choose who you are and see the packages built for you. Every package can be mixed with add ons.</p>
    <div class="aud-grid">
      {services.map((s, i) => (
        <a href={`/services/${s.slug}`} class="aud">
          <p class="label"><span class="num">{String(i + 1).padStart(2, '0')}</span>{s.packages.length} {s.packages.length === 1 ? 'package' : 'packages'}</p>
          <h2 class="display">{s.name}</h2>
          <p class="muted">{s.tagline}</p>
          <p class="from label">From {s.packages.map((p) => p.price).sort((a, b) => parseInt(a.replace(/\D/g, '')) - parseInt(b.replace(/\D/g, '')))[0]}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap agency">
    <div>
      <p class="label"><span class="num">05</span>Agencies & producers</p>
      <h2 class="display h2">Director & Cinematographer Day</h2>
      <p class="muted">$1,200 per day. Up to 8 hours in Philadelphia with camera, compact lighting and audio, a prep call and organized camera originals. Editing quoted separately.</p>
    </div>
    <a href="/contact" class="btn">Check availability</a>
  </section>

  <section class="section wrap two">
    <div>
      <p class="label"><span class="num">06</span>Questions</p>
      <h2 class="display h2">How it works</h2>
    </div>
    <div>{faq.map(([q, a]) => (<details><summary>{q}</summary><p class="muted">{a}</p></details>))}</div>
  </section>
</Base>

<style>
  .h1 { font-size: clamp(3.5rem, 9vw, 8rem); margin: 1rem 0 1.5rem; }
  .intro { font-size: 1.2rem; max-width: 40rem; color: var(--text-2); margin-bottom: 3rem; }
  .aud-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); border-top: 1px solid #2c2c2c; }
  .aud { padding: 2.5rem 2rem 2.5rem 0; border-bottom: 1px solid #2c2c2c; }
  .aud h2 { font-size: clamp(2.6rem, 4vw, 3.6rem); margin: .75rem 0; transition: color .2s; }
  .aud:hover h2 { color: var(--accent); }
  .from { margin-top: 1.5rem; color: var(--text); }
  .agency { display: flex; justify-content: space-between; align-items: end; gap: 2rem; background: var(--bg-2); padding-block: 3rem; flex-wrap: wrap; }
  .agency p.muted { max-width: 38rem; }
  .h2 { font-size: clamp(2.4rem, 5vw, 4rem); margin: .75rem 0 1rem; }
  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: 3rem; }
  details { border-bottom: 1px solid #2c2c2c; padding: 1.25rem 0; }
  summary { cursor: pointer; font-weight: 600; font-size: 1.05rem; }
  details p { margin: .75rem 0 0; }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
</style>
