---
import Base from '../layouts/Base.astro';
import Ornament from '../components/Ornament.astro';
---
<Base compact title="Inquiry received | Dakota Weik">
  <section class="wrap done">
    <Ornament width={110} />
    <p class="kicker">Inquiry received</p>
    <h1 class="h-display">Thank you. Your inquiry is on my desk.</h1>
    <p>I reply within two business days. To add a brief, references or dates, email <a href="mailto:info@inkedabroad.com" class="link">info@inkedabroad.com</a>.</p>
    <a href="/#work" class="btn">Back to the work</a>
  </section>
</Base>
<style>
  .done { text-align: center; padding-block: clamp(3rem, 8vw, 6rem); max-width: calc(720px + var(--gut) * 2); }
  .done :global(.ornament) { margin: 0 auto 1rem; }
  h1 { font-size: clamp(34px, 5vw, 56px); margin: .3rem 0 1rem; }
  p { margin: 0 0 1.8rem; }
</style>
