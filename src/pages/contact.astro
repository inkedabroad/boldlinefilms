---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import services from '../data/services.json';
const types = [...services.flatMap((s) => s.packages.map((p) => `${s.name}: ${p.name}`)), 'Director & Cinematographer Day', 'Something else'];
const budgets = ['Under $1,500', '$1,500 to $3,000', '$3,000 to $5,000', '$5,000 to $10,000', '$10,000+', 'Still deciding'];
const timing = ['As soon as possible', 'Within one month', 'Within three months', 'Flexible'];
---
<Base title="Start a Project | Dakota Weik, Philadelphia Director & Cinematographer" description="Tell Dakota Weik about your business and the film you want to make.">
  <section class="section wrap grid">
    <div>
      <p class="label"><span class="num">01</span>Contact</p>
      <h1 class="display h1">Start a project</h1>
      <p class="lead">Tell me what you're building and what you'd like the film to do. I reply to every serious inquiry.</p>
      <p class="muted">Prefer email? <a href={`mailto:${site.email}`} class="link">{site.email}</a></p>
      <p class="muted">Agencies and producers: mention your shoot dates and I'll confirm availability.</p>
    </div>

    <form name="inquiry" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="company_site" class="form">
      <input type="hidden" name="form-name" value="inquiry" />
      <p class="hp"><label>Leave this empty <input name="company_site" tabindex="-1" autocomplete="off" /></label></p>
      <div class="row">
        <label>Name<input name="name" required autocomplete="name" maxlength="120" /></label>
        <label>Email<input type="email" name="email" required autocomplete="email" maxlength="160" /></label>
      </div>
      <div class="row">
        <label>Company<input name="company" autocomplete="organization" maxlength="160" /></label>
        <label>Website or social link<input name="website" maxlength="300" /></label>
      </div>
      <label>I am a
        <select name="client_type" id="client_type" required>
          <option value="" disabled selected>Choose one</option>
          {services.map((s) => <option value={s.slug}>{({ 'tattoo-artists': 'Tattoo artist', 'tattoo-shops': 'Tattoo shop', 'local-business': 'Local business', conventions: 'Convention organizer' } as Record<string, string>)[s.slug]}</option>)}
          <option value="agency">Agency or producer</option>
          <option value="other">Something else</option>
        </select>
      </label>
      <label>Package
        <select name="project_type" id="project_type" required>
          <option value="" disabled selected>Choose one</option>
          {types.map((t) => <option>{t}</option>)}
        </select>
      </label>
      <div class="row">
        <label>Estimated budget
          <select name="budget" required>
            <option value="" disabled selected>Choose one</option>
            {budgets.map((t) => <option>{t}</option>)}
          </select>
        </label>
        <label>Timeframe
          <select name="timeframe">
            {timing.map((t) => <option>{t}</option>)}
          </select>
        </label>
      </div>
      <label>Location<input name="location" placeholder="City and state, or remote" maxlength="160" /></label>
      <label>About the project<textarea name="message" rows="6" required maxlength="4000" placeholder="Tell me what you're building and what you'd like the film to accomplish."></textarea></label>
      <label>How did you hear about me?<input name="source" maxlength="200" /></label>
      <label class="check"><input type="checkbox" name="consent" required /> I agree to be contacted about this inquiry.</label>
      <button type="submit" class="btn primary">Send inquiry</button>
    </form>
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const ct = document.getElementById('client_type') as HTMLSelectElement | null;
  const pt = document.getElementById('project_type') as HTMLSelectElement | null;
  if (ct && params.get('for')) ct.value = params.get('for') || '';
  if (pt && params.get('package')) {
    const opt = [...pt.options].find((o) => o.value.endsWith(params.get('package') || ''));
    if (opt) pt.value = opt.value;
  }
  const form = document.querySelector<HTMLFormElement>('form.form');
  form?.addEventListener('submit', () => {
    const b = form.querySelector('button');
    if (b) { b.setAttribute('disabled', ''); b.textContent = 'Sending…'; }
  });
</script>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(2rem, 5vw, 5rem); }
  .h1 { font-size: clamp(3.5rem, 8vw, 7rem); margin: 1rem 0 1.5rem; }
  .lead { font-size: 1.2rem; }
  .link { text-decoration: underline; text-underline-offset: 3px; }
  .form { display: grid; gap: 1.25rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  label { display: grid; gap: .45rem; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-2); }
  input, select, textarea {
    background: var(--bg-2); border: 1px solid #2f2f2f; color: var(--text); padding: .9rem 1rem;
    font: 400 1rem var(--body); letter-spacing: normal; text-transform: none; border-radius: 0; width: 100%;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--text-2); }
  .check { display: flex; align-items: center; gap: .75rem; text-transform: none; letter-spacing: normal; font-size: .95rem; }
  .check input { width: auto; }
  .hp { position: absolute; left: -9999px; }
  .form .btn { justify-self: start; }
  @media (max-width: 820px) { .grid, .row { grid-template-columns: 1fr; } }
</style>
