---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/photos/dakota.jpg';
import hallsLogo from '../assets/links/halls-logo.webp';
import lbiTitle from '../assets/links/lbi-title.webp';
import boxImage from '../assets/links/artist-box.webp';
import picklesLogo from '../assets/links/dr-pickles-logo.webp';
import ezLogo from '../assets/links/ez-tattoo-logo.webp';
import { socials, artistBox, drPickles, ezTattoo, shelf } from '../data/links';
import { lifeBeyondInk, conventions, posterOf } from '../data/films';

const films = [...lifeBeyondInk, ...conventions];
const posters = shelf.flatMap((entry) => {
  const film = films.find((f) => f.id === entry.film);
  const poster = film && posterOf(film);
  return film?.youtube && poster ? [{ title: entry.title, href: `https://youtu.be/${film.youtube}`, poster }] : [];
});
---
<Base bare title="Links" description="Dakota Weik, tattoo ethnographer and filmmaker. Films, The Halls of Ink, the Artist Box and partner codes.">
  <div class="page">
    <header class="intro">
      <Image class="portrait" src={portrait} alt="Dakota in the rice terraces" widths={[480, 880, 1145]} sizes="(max-width: 520px) 100vw, 440px" loading="eager" fetchpriority="high" />
      <h1>Dakota Weik</h1>
      <p class="bio">Tattoo ethnographer and filmmaker</p>
      <nav class="socials" aria-label="Dakota on social media">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
      </nav>
    </header>

    <nav class="cards" aria-label="Explore Dakota's work">
      <a class="bubble card featured" href="https://hallsofinkarchives.com">
        <span class="plate"><Image src={hallsLogo} alt="" width={120} /></span>
        <span class="text"><strong>THE HALLS OF INK</strong><small>Find the world's best tattoo artists and the world's tattoo museum.</small></span>
        <svg class="chev" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="m2 3 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="bubble card" href="https://lifebeyondinkseries.com" target="_blank" rel="noopener noreferrer">
        <span class="plate wide"><Image src={lbiTitle} alt="" width={240} /></span>
        <span class="text"><strong class="sr">LIFE BEYOND INK</strong><small>Inside the lives of the world's most extraordinary tattoo artists.</small><em>Original films by @inkedabroad</em></span>
        <svg class="chev" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="m2 3 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </nav>

    <a class="bubble box" href={artistBox.href} target="_blank" rel="sponsored noopener noreferrer"
      aria-label={`My Artist Box, the custom handmade box I made for artists with Dr Pickles. ${artistBox.price}. Opens the box in the Dr Pickles shop.`}>
      <span class="stage"><Image src={boxImage} alt="" widths={[320, 640]} sizes="300px" loading="eager" /></span>
      <span class="box-text">
        <strong>MY ARTIST BOX</strong>
        <small>The custom handmade box I made for artists, with Dr Pickles.</small>
        <span class="buy"><span class="price">{artistBox.price}</span><span class="shop">Shop the box</span></span>
      </span>
    </a>

    <section class="films" aria-labelledby="films-title">
      <h2 id="films-title">THE FILMS</h2>
      <div class="shelf" role="region" aria-label="Film posters. Swipe to explore" tabindex="0">
        {posters.map((p) => (
          <a class="poster" href={p.href} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${p.title} in a new tab`}>
            <Image src={p.poster} alt={p.title} height={680} loading="lazy" />
          </a>
        ))}
      </div>
      <p class="hint">Swipe the series. Tap a poster to watch.</p>
    </section>

    <section class="partners" aria-labelledby="partners-title">
      <h2 id="partners-title">PARTNER CODES</h2>
      <div class="passes">
        <button type="button" class="bubble pass" id="pickles" data-code={drPickles.code} data-href={drPickles.href} aria-label="Dr Pickles. 10% off your order. Copy code and open shop in a new tab">
          <span class="logo"><Image src={picklesLogo} alt="" width={260} loading="lazy" /></span>
          <span class="name">DR PICKLES</span><span class="cat">Tattoo aftercare</span><span class="offer">10% off your order</span>
          <span class="chip code" id="pickles-chip">{drPickles.code}</span>
        </button>
        <a class="bubble pass" href={ezTattoo.href} target="_blank" rel="sponsored noopener noreferrer" aria-label="EZ Tattoo. 10% off tattoo machines. Opens the shop in a new tab">
          <span class="logo"><Image src={ezLogo} alt="" width={260} loading="lazy" /></span>
          <span class="name">EZ TATTOO</span><span class="cat">Tattoo machines</span><span class="offer">10% off</span>
          <span class="chip">Shop</span>
        </a>
      </div>
    </section>
    <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
  </div>
</Base>

<script>
  // Dr Pickles tile: copy the code, show the message for two seconds, then open the shop.
  const tile = document.getElementById('pickles') as HTMLButtonElement;
  const chip = document.getElementById('pickles-chip') as HTMLElement;
  const toast = document.getElementById('toast') as HTMLElement;
  const code = tile.dataset.code!;
  const shop = tile.dataset.href!;
  let busy = false;

  function legacyCopy(value: string): boolean {
    const area = document.createElement('textarea');
    area.value = value; area.readOnly = true;
    area.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:18px';
    document.body.appendChild(area);
    let ok = false;
    try { area.focus(); area.select(); area.setSelectionRange(0, value.length); ok = document.execCommand('copy'); } catch { ok = false; }
    area.remove(); tile.focus({ preventScroll: true });
    return ok;
  }

  function finish(copied: boolean, tab: Window | null) {
    const blocked = !tab || tab.closed;
    const result = copied ? `Code ${code} copied` : `Could not copy. Use code ${code} at checkout.`;
    toast.textContent = blocked ? `${result} Popup blocked. Opening shop in this tab.` : result;
    if (copied) { chip.textContent = 'Copied'; chip.classList.add('copied'); }
    setTimeout(() => {
      toast.textContent = ''; chip.textContent = code; chip.classList.remove('copied');
      busy = false; tile.removeAttribute('aria-busy');
      if (tab && !tab.closed) { try { tab.location.replace(shop); return; } catch { tab.close(); } }
      window.location.assign(shop);
    }, 2000);
  }

  tile.addEventListener('click', () => {
    if (busy) return;
    busy = true; tile.setAttribute('aria-busy', 'true');
    // Copy while this page still has focus, then reserve the tab during the same tap so phones allow it.
    const copied = legacyCopy(code);
    let pending: Promise<boolean> | null = null;
    if (!copied && navigator.clipboard?.writeText) {
      try { pending = navigator.clipboard.writeText(code).then(() => true, () => false); } catch { /* shop stays reachable */ }
    }
    let tab: Window | null = null;
    try {
      tab = window.open('about:blank', '_blank');
      if (tab) { tab.opener = null; tab.document.title = 'Opening shop'; }
    } catch { tab?.close(); tab = null; }
    if (copied) finish(true, tab);
    else if (pending) void pending.then((ok) => finish(ok, tab));
    else finish(false, tab);
  });
</script>

<style>
  .page { max-width: 440px; margin: 0 auto; padding: 0 16px max(36px, env(safe-area-inset-bottom)); }
  a { text-decoration: none; }
  .intro { text-align: center; margin: 0 -16px 18px; }
  .intro :global(.portrait) { display: block; width: 100%; height: clamp(340px, 52dvh, 560px); object-fit: cover; object-position: 50% 22%; border-bottom: 3px double var(--ink); }
  h1 { font-family: var(--plate); font-weight: 400; font-size: clamp(2.6rem, 12vw, 3.4rem); line-height: 1; margin: 16px 0 0; }
  .bio { font-family: var(--type); font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin: 8px 0 8px; }
  .socials { display: flex; justify-content: center; gap: 10px; }
  .socials a { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; color: var(--ink); border: 1px solid var(--ink); }
  .socials a:hover { background: var(--ink); color: var(--paper); }
  @media (min-width: 521px) { .intro { margin-inline: 0; } .intro :global(.portrait) { border: 1px solid var(--ink); border-top: 0; border-radius: 0 0 20px 20px; } }

  .bubble { display: block; background: var(--paper-2); border: 1px solid var(--ink); border-radius: 20px; color: var(--ink); transition: transform .15s ease, box-shadow .15s ease; }
  a.bubble:hover, button.bubble:hover { box-shadow: 3px 3px 0 var(--ink); transform: translate(-1px, -1px); }
  .bubble:active { transform: scale(.985); }
  .cards { display: grid; gap: 12px; }
  .card { display: grid; grid-template-columns: auto minmax(0, 1fr) 12px; gap: 14px; align-items: center; min-height: 104px; padding: 14px 16px; }
  .featured { border-width: 2px; min-height: 124px; }
  .plate { display: grid; place-items: center; width: 68px; height: 84px; border-radius: 10px; background: #000; padding: 6px; }
  .plate.wide { width: 112px; height: auto; padding: 0; overflow: hidden; }
  .plate :global(img) { display: block; width: 100%; height: auto; }
  .text strong { display: block; font-family: var(--display); font-weight: 800; font-size: 1.12rem; letter-spacing: .03em; line-height: 1.2; }
  .text small { display: block; font-size: 1rem; line-height: 1.3; margin-top: 4px; color: var(--ink-2); }
  .text em { display: block; font-size: .92rem; margin-top: 5px; color: var(--red); }
  .chev { width: 10px; height: 16px; color: var(--ink-2); }
  .sr { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .box { margin-top: 12px; overflow: hidden; border-width: 2px; }
  .stage { display: flex; justify-content: center; padding: 18px 28px 14px; background: #fff; border-bottom: 1px solid var(--ink); }
  .stage :global(img) { display: block; width: 100%; max-width: 300px; height: auto; }
  .box-text { display: grid; gap: 5px; padding: 14px 18px 18px; }
  .box-text strong { font-family: var(--display); font-weight: 800; font-size: 1.15rem; letter-spacing: .03em; }
  .box-text small { font-size: 1rem; line-height: 1.35; color: var(--ink-2); }
  .buy { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; }
  .price { font-family: var(--type); font-size: 1.1rem; }
  .shop { display: inline-flex; align-items: center; min-height: 46px; padding: 0 22px; border-radius: 999px; background: var(--ink); color: var(--paper); font-family: var(--type); font-size: .9rem; letter-spacing: .08em; text-transform: uppercase; }

  h2 { font-family: var(--type); font-weight: 400; font-size: .9rem; letter-spacing: .2em; text-align: center; margin: 0 0 16px; padding: 10px 0 7px; border-block: 1px solid var(--ink); }
  .films { margin-top: 34px; }
  .shelf { display: flex; gap: 14px; overflow-x: auto; margin: 0 -16px; padding: 6px 16px 14px; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .shelf::-webkit-scrollbar { display: none; }
  .poster { flex: 0 0 auto; height: 340px; border-radius: 14px; overflow: hidden; scroll-snap-align: center; border: 1px solid var(--ink); background: var(--ink); }
  .poster :global(img) { display: block; width: auto; max-width: none; height: 340px; }
  .hint { margin: 2px 0 0; font-style: italic; text-align: center; color: var(--ink-2); }
  @media (max-width: 520px) { .shelf { width: 100vw; margin-inline: calc(50% - 50vw); } }

  .partners { margin-top: 34px; }
  .passes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .pass { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 8px 14px; overflow: hidden; font: inherit; cursor: pointer; width: 100%; }
  .logo { display: grid; place-items: center; width: calc(100% + 16px); height: 104px; margin: 0 -8px 12px; padding: 14px 16px; background: #fff; border-bottom: 1px solid var(--ink); }
  .logo :global(img) { display: block; width: 100%; height: 76px; object-fit: contain; }
  .name { font-family: var(--display); font-weight: 800; font-size: .98rem; letter-spacing: .05em; }
  .cat { font-style: italic; font-size: .95rem; color: var(--ink-2); margin-top: 2px; }
  .offer { font-family: var(--type); font-size: .95rem; margin: 8px 0 12px; }
  .chip { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--ink); font-family: var(--type); font-size: .82rem; letter-spacing: .06em; margin-top: auto; }
  .chip.code { border-style: dashed; }
  .chip.copied { background: var(--ink); color: var(--paper); border-style: solid; }
  .toast { position: fixed; z-index: 1000; bottom: max(20px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: max-content; max-width: calc(100vw - 32px); padding: 12px 20px; border-radius: 14px; background: var(--ink); color: var(--paper); text-align: center; font-family: var(--type); font-size: .9rem; }
  .toast:empty { display: none; }
</style>
