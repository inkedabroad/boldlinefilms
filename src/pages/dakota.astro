---
import { Image } from 'astro:assets';
import '@fontsource/alegreya-sc/400.css';
import Base from '../layouts/Base.astro';
import '../styles/dakota.css';
import portrait from '../assets/photos/dakota.jpg';
import hallsLogo from '../assets/links/halls-logo.webp';
import lbiTitle from '../assets/links/lbi-title.webp';
import iaLogo from '../assets/links/inked-abroad-logo.png';
import boxImage from '../assets/links/artist-box.webp';
import picklesLogo from '../assets/links/dr-pickles-logo.webp';
import ezLogo from '../assets/links/ez-tattoo-logo.webp';
import { socials, artistBox, drPickles, ezTattoo, shelf } from '../data/links';
import { lifeBeyondInk, conventions, posterOf } from '../data/films';

const films = [...lifeBeyondInk, ...conventions];
const posters = shelf.flatMap((entry) => {
  const film = films.find((f) => f.id === entry.film);
  const poster = film && posterOf(film);
  return film?.youtube && poster ? [{ title: entry.title, href: `https://youtu.be/${film.youtube}`, poster }] : [];
});
---
<Base bare themeColor="#000000" title="Links" description="Dakota Weik, tattoo ethnographer and filmmaker. Films, The Halls of Ink, the Artist Box and partner codes.">
  <div class="dakotaLinkPage">
    <div class="dakotaLinkColumn">
      <header class="dakotaLinkIntro">
        <Image class="dakotaLinkPortrait" src={portrait} alt="Dakota in the rice terraces" widths={[480, 880, 1145]} sizes="(max-width: 520px) 100vw, 440px" loading="eager" fetchpriority="high" />
        <div class="dakotaLinkIdentity">
          <h1 class="dakotaLinkName">Dakota Weik</h1>
          <p class="dakotaLinkBio">Tattoo ethnographer and filmmaker</p>
          <nav class="dakotaLinkSocials" aria-label="Dakota on social media">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="dakotaLinkSocial" aria-label={s.label}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
              </a>
            ))}
          </nav>
        </div>
      </header>

      <nav class="dakotaMainCards" aria-label="Explore Dakota's work">
        <a href="https://hallsofinkarchives.com" class="dakotaBubble dakotaMainCard dakotaMainCardFeatured">
          <Image class="dakotaBrandLogo" src={hallsLogo} alt="" width={220} height={275} />
          <span><strong>THE HALLS OF INK</strong><small>The Archives of Tattooing</small></span>
          <svg class="dakotaChevron" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="m2 3 5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href="https://lifebeyondinkseries.com" class="dakotaBubble dakotaMainCard" target="_blank" rel="noopener noreferrer">
          <Image class="dakotaTitleArt" src={lbiTitle} alt="" width={360} height={152} />
          <span><strong class="dakotaSrOnly">LIFE BEYOND INK</strong><small>Inside the lives of the world's most extraordinary tattoo artists.</small><em class="dakotaCardCredit">Original films by @inkedabroad</em></span>
          <svg class="dakotaChevron" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="m2 3 5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href="/" class="dakotaBubble dakotaMainCard dakotaLogoCard dakotaWorkCard">
          <Image class="dakotaBrandLogo" src={iaLogo} alt="" width={642} height={428} />
          <span><strong>WORK WITH ME</strong></span>
          <span class="dakotaGo">Open</span>
        </a>
        <div class="dakotaBubble dakotaMainCard dakotaLogoCard dakotaCardPending" aria-disabled="true">
          <Image class="dakotaBrandLogo" src={iaLogo} alt="" width={642} height={428} />
          <span><strong>MERCH AND PRINTS</strong></span>
          <span class="dakotaPendingTag">Coming soon</span>
        </div>
      </nav>

      <section class="dakotaFilms" aria-labelledby="dakota-films-title">
        <h2 class="dakotaSectionTitle" id="dakota-films-title">THE FILMS</h2>
        <div class="dakotaFilmShelf" role="region" aria-label="Film posters. Swipe to explore" tabindex="0">
          {posters.map((p) => (
            <a class="dakotaBubble dakotaFilmPoster" href={p.href} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${p.title} in a new tab`}>
              <Image src={p.poster} alt={p.title} height={680} loading="lazy" />
            </a>
          ))}
        </div>
        <p class="dakotaShelfHint">Swipe the series. Tap a poster to watch.</p>
      </section>

      <a href={artistBox.href} class="dakotaBox" target="_blank" rel="sponsored noopener noreferrer"
        aria-label={`My Artist Box, the custom handmade box I made for artists with Dr Pickles. ${artistBox.price}. Opens the box in the Dr Pickles shop.`}>
        <span class="dakotaBoxStage"><Image src={boxImage} alt="" width={640} height={545} loading="eager" /></span>
        <span class="dakotaBoxText">
          <strong>MY ARTIST BOX</strong>
          <small>The custom handmade box I made for artists, with Dr Pickles.</small>
          <span class="dakotaBoxBuy"><span class="dakotaBoxPrice">{artistBox.price}</span><span class="dakotaBoxButton">Shop the box</span></span>
        </span>
      </a>

      <section class="dakotaPartners" aria-labelledby="dakota-partners-title">
        <h2 id="dakota-partners-title" class="dakotaSectionTitle">PARTNER CODES</h2>
        <div class="dakotaPasses">
          <button type="button" class="dakotaBubble dakotaPartnerTile dakotaPass" id="pickles" data-code={drPickles.code} data-href={drPickles.href} aria-label="Dr Pickles. 10% off your order. Copy code and open shop in a new tab">
            <Image class="dakotaPartnerArt" src={picklesLogo} alt="" width={520} height={425} loading="lazy" />
            <span class="dakotaPartnerName">DR PICKLES</span><span class="dakotaPartnerCategory">Tattoo aftercare</span><span class="dakotaPartnerOffer">10% off your order</span>
            <span class="dakotaPartnerChip dakotaPartnerChipCode" id="pickles-chip">{drPickles.code}</span>
          </button>
          <a href={ezTattoo.href} target="_blank" rel="sponsored noopener noreferrer" class="dakotaBubble dakotaPartnerTile dakotaPass" aria-label="EZ Tattoo. 10% off tattoo machines. Opens the shop in a new tab">
            <Image class="dakotaPartnerArt" src={ezLogo} alt="" width={500} height={213} loading="lazy" />
            <span class="dakotaPartnerName">EZ TATTOO</span><span class="dakotaPartnerCategory">Tattoo machines</span><span class="dakotaPartnerOffer">10% off</span><span class="dakotaPartnerChip">Shop</span>
          </a>
        </div>
      </section>
    </div>
    <div class="dakotaLinkToast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
  </div>
</Base>

<script>
  // Dr Pickles tile: copy the code, show the message for two seconds, then open the shop.
  const tile = document.getElementById('pickles') as HTMLButtonElement;
  const chip = document.getElementById('pickles-chip') as HTMLElement;
  const toast = document.getElementById('toast') as HTMLElement;
  const code = tile.dataset.code!;
  const shop = tile.dataset.href!;
  let busy = false;

  function legacyCopy(value: string): boolean {
    const area = document.createElement('textarea');
    area.value = value; area.readOnly = true;
    area.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:18px';
    document.body.appendChild(area);
    let ok = false;
    try { area.focus(); area.select(); area.setSelectionRange(0, value.length); ok = document.execCommand('copy'); } catch { ok = false; }
    area.remove(); tile.focus({ preventScroll: true });
    return ok;
  }

  function finish(copied: boolean, tab: Window | null) {
    const blocked = !tab || tab.closed;
    const result = copied ? `Code ${code} copied` : `Could not copy. Use code ${code} at checkout.`;
    toast.textContent = blocked ? `${result} Popup blocked. Opening shop in this tab.` : result;
    if (copied) { chip.textContent = 'Copied'; chip.classList.add('dakotaPartnerChipCopied'); }
    setTimeout(() => {
      toast.textContent = ''; chip.textContent = code; chip.classList.remove('dakotaPartnerChipCopied');
      busy = false; tile.removeAttribute('aria-busy');
      if (tab && !tab.closed) { try { tab.location.replace(shop); return; } catch { tab.close(); } }
      window.location.assign(shop);
    }, 2000);
  }

  tile.addEventListener('click', () => {
    if (busy) return;
    busy = true; tile.setAttribute('aria-busy', 'true');
    // Copy while this page still has focus, then reserve the tab during the same tap so phones allow it.
    const copied = legacyCopy(code);
    let pending: Promise<boolean> | null = null;
    if (!copied && navigator.clipboard?.writeText) {
      try { pending = navigator.clipboard.writeText(code).then(() => true, () => false); } catch { /* shop stays reachable */ }
    }
    let tab: Window | null = null;
    try {
      tab = window.open('about:blank', '_blank');
      if (tab) { tab.opener = null; tab.document.title = 'Opening shop'; tab.document.documentElement.style.background = '#000'; }
    } catch { tab?.close(); tab = null; }
    if (copied) finish(true, tab);
    else if (pending) void pending.then((ok) => finish(ok, tab));
    else finish(false, tab);
  });
</script>

