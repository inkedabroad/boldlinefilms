---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FilmGrid from '../components/FilmGrid.astro';
import portrait from '../assets/photos/dakota.jpg';
import { site } from '../data/site';
import { lifeBeyondInk } from '../data/films';
---
<Base>
  <section class="lead">
    <figure>
      <Image src={portrait} alt="Dakota Weik" widths={[480, 720, 1145]} sizes="(max-width: 860px) 92vw, 560px" loading="eager" fetchpriority="high" />
    </figure>
    <p class="line">{site.tagline}</p>
  </section>

  <section aria-labelledby="lbi">
    <hr class="rule" />
    <h2 id="lbi">Life Beyond Ink</h2>
    <hr class="rule" />
    <div class="films"><FilmGrid films={lifeBeyondInk} /></div>
  </section>
</Base>
<style>
  .lead { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(1.5rem, 5vw, 4.5rem); align-items: center; padding-block: clamp(1.4rem, 4vw, 3rem) clamp(2.2rem, 5vw, 4rem); }
  figure { margin: 0; border: 1px solid var(--ink); padding: 8px; background: var(--paper-2); }
  figure :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 22%; }
  .line { font-family: var(--display); font-weight: 800; font-size: clamp(2.2rem, 5.2vw, 4.6rem); line-height: 1.02; letter-spacing: -.015em; margin: 0; text-wrap: balance; }
  h2 { font-family: var(--display); font-weight: 800; font-size: clamp(2.4rem, 7vw, 4.6rem); line-height: 1; text-align: center; margin: .9rem 0 1rem; }
  .films { margin-top: clamp(1.8rem, 4vw, 3rem); }
  @media (max-width: 860px) { .lead { grid-template-columns: minmax(0, 1fr); } .line { text-align: center; } }
</style>
