---
import Base from '../layouts/Base.astro';
import Inquiry from '../components/Inquiry.astro';
import site from '../data/site.json';
import { featured, selected, relatedTo, stillOf } from '../data/work';
const f: any = featured;
const related = relatedTo(featured);
const clients = ['Dr. Pickles', 'EZ Tattoo', 'A Pound of Flesh'];
const [lead, ...rest] = site.services;
const cardImg = (p: any) => p.card || stillOf(p);
---
<Base>
  <section class="hero wrap" aria-labelledby="who">
    <div class="hero-text">
      <p class="kicker">Tattoo ethnographer and filmmaker</p>
      <h1 id="who" class="h-display name">Dakota <em>Weik</em></h1>
      <p class="deck">I make films for <span class="scribble">tattoo conventions</span>, artists, independent businesses <em>and</em> brands.</p>
      <p class="based">Based in Philadelphia and available worldwide.</p>
      <div class="actions"><a href="#inquire" class="btn">Start a project</a><a href="#work" class="link">See the work</a></div>
    </div>
    <figure class="hero-photo">
      <div class="print tilt-l"><img src="/media/dakota-hero.jpg" alt="Dakota Weik" width="1145" height="1431" fetchpriority="high" /></div>
      <figcaption class="ribbon hero-ribbon">Buscalan, Philippines</figcaption>
    </figure>
  </section>

  <div class="wrap"><hr class="rule-double" /></div>

  <section id="work" class="section wrap">
    <h2 class="h-section"><span class="n">01.</span>Featured film</h2>
    <div style="height:1.8rem"></div>
    <div class="feature">
      <a href={`/work/${f.slug}/`} class="print feat-print" aria-label={`Watch ${f.title}`}>
        <picture>
          {f.stillMobile && <source media="(max-width: 760px)" srcset={f.stillMobile} width="700" height="525" />}
          <img src={f.still} alt={`${f.event}, from the film ${f.title}`} width={f.stillW || 980} height={f.stillH || 445} loading="lazy" />
        </picture>
        <span class="play" aria-hidden="true">▶</span>
      </a>
      <div class="card feat-card">
        <p class="card-kicker">{f.label}</p>
        <h3 class="feat-title">{f.event}</h3>
        <p class="meta">{[f.place, f.runtime].filter(Boolean).join(' · ')}</p>
        <a href={`/work/${f.slug}/`} class="btn">Watch the film</a>
        {related.length > 0 && <p class="meta rel">Also from this event: {related.map((r, i) => <>{i > 0 && ', '}<a href={`/work/${r.slug}/`}>{r.title}</a></>)}</p>}
      </div>
    </div>
  </section>

  <section class="section wrap selected">
    <h2 class="h-section"><span class="n">02.</span>Selected work</h2>
    <div class="grid">
      {selected.map((p: any, i: number) => (
        <article class="item">
          <a href={`/work/${p.slug}/`} class:list={['print', 'item-print', i % 2 ? 'tilt-r' : 'tilt-l']}><img src={cardImg(p)} alt={p.caption || `Still from ${p.title}`} loading="lazy" decoding="async" width="576" height="720" /></a>
          <p class="item-label">{p.label}</p>
          <h3 class="item-title"><a href={`/work/${p.slug}/`}>{p.title}</a></h3>
          <p class="meta">{p.made}. {p.role}.</p>
        </article>
      ))}
    </div>
    <p class="clients">Selected clients <span>{clients.join('  ·  ')}</span></p>
  </section>

  <section id="services" class="wrap">
    <div class="ad">
      <h2 class="ad-head">Work with me</h2>
      <div class="ad-card">
        <h3 class="ad-title">Convention coverage</h3>
        <p>Weekend film coverage, a cinematic recap and social edits. Hosting and Nikon F2 photography can be included in the agreed scope.</p>
        <a href="/?for=convention#inquire" class="btn preset" data-for="convention">Discuss your convention</a>
      </div>
      <ul class="panels">
        {rest.map((s, i) => (
          <li>
            <a href={`/?for=${s.slug}#inquire`} class="panel preset" data-for={s.slug} aria-label={s.cta}>
              
            </a>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <a href={`/?for=${s.slug}#inquire`} class="link preset" data-for={s.slug}>Inquire</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="about" class="section wrap about">
    <h2 class="h-section"><span class="n">03.</span>About Dakota</h2>
    <p class="about-copy"><span class="drop">I</span>’m Dakota Weik, a tattoo ethnographer and filmmaker based in Philadelphia. I study tattooing around the world and practice it myself. Through Inked Abroad, I make commissioned films and create the original series Life Beyond Ink and Indigenous Revival. When you hire Inked Abroad, you work directly with me.</p>
  </section>

  <section id="inquire" class="wrap">
    <div class="form-card print">
      <p class="ribbon form-ribbon">Inquire</p>
      <h2 class="h-section">Tell me about your project</h2>
      <p class="muted form-intro">I reply within two business days.</p>
      <Inquiry />
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.preset').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('inquiry:preset', { detail: { type: a.dataset.for } }));
    document.getElementById('inquire')?.scrollIntoView();
  }));
</script>

<style>
  .tilt-l { transform: rotate(-1.6deg); } .tilt-r { transform: rotate(1.4deg); }
  .hero { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem); overflow: hidden; }
  .ghost { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-46%); margin: 0; text-align: center; font-family: var(--gothic); text-transform: uppercase; font-size: clamp(100px, 19vw, 260px); line-height: .8; color: var(--green-soft); opacity: .55; letter-spacing: .02em; pointer-events: none; z-index: 0; white-space: nowrap; }
  .hero-text, .hero-photo { position: relative; z-index: 1; }
  .name { font-size: clamp(52px, 7.4vw, 108px); line-height: .95; margin-bottom: 1rem; }
  .name em { font-style: italic; }
  .deck { font-family: var(--display); font-size: clamp(22px, 2.3vw, 32px); line-height: 1.3; margin: 0 0 .6rem; color: var(--ink); }
  .deck em { color: var(--green); }
  .based { font-style: italic; margin: 0 0 1.6rem; color: var(--ink-2); }
  .actions { display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap; }
  .hero-photo { margin: 0; justify-self: center; width: min(100%, 470px); }
  .hero-photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 22%; }
  .hero-ribbon { position: absolute; left: 50%; bottom: -14px; transform: translateX(-50%) rotate(-1.6deg); font-size: 18px; white-space: nowrap; background: var(--brick); }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; text-align: left; }
    .hero-photo { order: -1; width: min(88%, 420px); margin-bottom: 1rem; }
    .ghost { display: none; }
  }

  .sub { font-style: italic; color: var(--ink-2); margin: .2rem 0 2rem; }
  .feature { position: relative; display: grid; grid-template-columns: 1.7fr 1fr; align-items: center; }
  .feat-print { display: block; position: relative; transform: rotate(-1deg); }
  .feat-print img { width: 100%; height: auto; }
  .play { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; background: var(--paper-2); color: var(--green); font-size: 28px; padding-left: 6px; box-shadow: 0 6px 18px rgba(0,0,0,.4); border: 3px solid var(--green); }
  .card { background: #FBF8EF; box-shadow: 0 14px 30px -12px rgba(40,28,10,.5); padding: clamp(1.2rem, 3vw, 2rem); }
  .feat-card { margin-left: -12%; transform: rotate(2deg); position: relative; z-index: 2; }
  .card-kicker { font-family: var(--display); font-style: italic; font-size: 20px; color: var(--ink-2); margin: 0; }
  .feat-title { font-family: var(--display); font-style: italic; font-weight: 700; font-size: clamp(30px, 3.4vw, 46px); line-height: 1; color: var(--green); margin: .2rem 0 .3rem; text-transform: uppercase; letter-spacing: -.01em; }
  .feat-card .meta { margin: 0 0 1.2rem; }
  .rel { margin: 1rem 0 0 !important; }
  @media (max-width: 860px) { .feature { grid-template-columns: 1fr; } .feat-card { margin: -1.5rem 1rem 0; transform: rotate(1.2deg); } }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem); margin-top: 2.2rem; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
  .item-print { display: block; margin-bottom: 1.3rem; }
  .item-print img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .item-label { font-family: var(--gothic); letter-spacing: .2em; text-transform: uppercase; color: var(--red); margin: 0; font-size: 17px; }
  .item-title { font-family: var(--display); font-weight: 700; font-size: clamp(26px, 2.5vw, 34px); line-height: 1.08; margin: .1rem 0 .3rem; color: var(--green); }
  .item-title a { text-decoration: none; } .item-title a:hover { color: var(--red); }
  .item .meta { margin: 0; }
  .clients { margin: clamp(2.5rem, 5vw, 3.5rem) 0 0; padding: .9rem 0; border-block: 1px solid var(--ink); text-align: center; font-family: var(--gothic); letter-spacing: .22em; text-transform: uppercase; font-size: 16px; color: var(--ink-2); }
  .clients span { display: inline-block; font-family: var(--display); font-style: italic; text-transform: none; letter-spacing: 0; font-size: 21px; color: var(--ink); margin-left: .8rem; }

  .ad { background: #FAF6EA; padding: clamp(1.4rem, 5vw, 3.5rem); box-shadow: 0 18px 40px -16px rgba(40,28,10,.45); border: 1px solid rgba(42,37,30,.15); }
  .ad-head { font-family: var(--display); font-weight: 400; color: var(--green); font-size: clamp(40px, 6.4vw, 86px); line-height: 1.02; margin: 0 0 clamp(1.5rem, 3vw, 2.5rem); }
  .ad-head em { font-style: italic; }
  .ad-card { background: #fff; max-width: 760px; margin: 0 auto clamp(2rem, 4vw, 3rem); padding: clamp(1.3rem, 3vw, 2.2rem); transform: rotate(-2deg); box-shadow: 0 16px 30px -12px rgba(40,28,10,.45); background-image: linear-gradient(90deg, rgba(240,180,60,.18), transparent 30%); }
  .ad-kick { font-family: var(--display); font-size: clamp(18px, 2vw, 24px); margin: 0; color: var(--ink-2); letter-spacing: .02em; }
  .ad-title { font-family: var(--display); font-style: italic; font-weight: 700; color: var(--green); font-size: clamp(36px, 5vw, 64px); line-height: .95; margin: .1rem 0 .8rem; }
  .ad-card p:not(.ad-kick) { margin: 0 0 1.3rem; max-width: 36rem; }
  .panels { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .panel { display: grid; place-items: center; aspect-ratio: 16 / 9; background: var(--salmon); text-decoration: none; margin-bottom: .8rem; position: relative; overflow: hidden; }
  .panel::before { content: ''; position: absolute; inset: 10px; border: 1.5px solid rgba(138,58,36,.5); }
  .panels li:nth-child(2) .panel { background: var(--mustard); }
  .panels li:nth-child(3) .panel { background: #D7C7A3; }
  .panel-mark { font-family: var(--script); font-size: clamp(34px, 3.6vw, 46px); color: var(--brick); transform: rotate(-6deg); }
  .panels h3 { font-family: var(--gothic); font-weight: 400; letter-spacing: .08em; text-transform: uppercase; color: var(--red); font-size: 24px; margin: 0 0 .2rem; text-align: center; }
  .panels p { font-size: 16px; margin: 0 0 .6rem; text-align: center; }
  .panels .link { display: table; margin: 0 auto; font-size: 18px; }
  @media (max-width: 760px) { .panels { grid-template-columns: 1fr; } .ad-card .btn { width: 100%; text-align: center; } }
  .ad-foot { margin: clamp(2rem, 4vw, 3rem) 0 0; text-align: center; font-family: var(--display); font-style: italic; text-transform: uppercase; letter-spacing: .14em; font-size: clamp(16px, 2.2vw, 28px); }
  .ad-foot span { color: var(--red); font-weight: 700; letter-spacing: .1em; }

  .about { max-width: calc(860px + var(--gut) * 2); }
  .about-copy { font-size: clamp(19px, 1.7vw, 23px); line-height: 1.6; margin: 1.2rem 0 0; }
  .drop { float: left; font-family: var(--display); font-weight: 700; color: var(--green); font-size: 4.6em; line-height: .8; margin: .06em .12em 0 0; }

  .form-card { max-width: 780px; margin: 0 auto; padding: clamp(1.4rem, 5vw, 3.2rem); position: relative; }
  .form-ribbon { position: absolute; top: -16px; left: 50%; transform: translateX(-50%); font-size: 20px; margin: 0; }
  .form-card .h-section { text-align: center; margin-top: .6rem; }
  .form-intro { text-align: center; font-style: italic; margin: .3rem 0 1.8rem; }
</style>
