---
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import Inquiry from '../components/Inquiry.astro';
import site from '../data/site.json';
import work from '../data/work.json';
const skits = work.skits.filter((s: any) => s.vimeo);
---
<Base>
  <section class="hero">
    <img class="hero-img" src="/media/dakota-hero.jpg" alt="Dakota Weik on location in Buscalan, Philippines" width="1145" height="1431" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-text wrap">
      <p class="label">Ethnographer and filmmaker</p>
      <h1>Dakota Weik</h1>
      <p class="hero-line">Films for tattoo conventions, artists, shops and brands.</p>
      <div class="hero-ctas"><a href="#hire" class="btn">Hire Me</a><a href="#films" class="btn ghost">Watch films</a></div>
    </div>
    <a href="#about" class="scroll" aria-label="Scroll down"><span>Scroll</span><i></i></a>
  </section>

  <section id="about" class="section wrap intro">
    <div class="reveal">
      <p class="hi"><em>Hi, I'm Dakota.</em></p>
      <p class="lead">I study and film tattooing across the world: the greatest tattoos, their artists, their history and their cultures. I'm also a tattoo artist.</p>
      <p class="muted">I create, write, direct and edit Life Beyond Ink and Indigenous Revival. Through Inked Abroad I make films for conventions, artists, shops and brands, and you work with me directly from the first call to the final cut. Based in Philadelphia. Available worldwide.</p>
    </div>
    <div class="reach reveal">
      <p class="label">Audience</p>
      <p class="big">{site.totalFollowers}</p>
      <p class="muted">people follow the work</p>
      <ul>{site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener"><span>{s.followers}</span><small>{s.label}</small></a></li>)}</ul>
    </div>
  </section>

  <section id="films" class="section">
    <div class="sec-head wrap reveal">
      <div><p class="label">Life Beyond Ink</p><h2 class="h2">Artist Films</h2><p class="muted">My original series on the world's greatest tattoo artists.</p></div>
      <a href={work.seriesLink} target="_blank" rel="noopener" class="btn ghost">Full series</a>
    </div>
    <Carousel items={work.films} id="films-track" ctaLine="Want a film like this about you?" ctaFor="artist" />
  </section>

  <section id="conventions" class="section">
    <div class="sec-head wrap reveal">
      <div><p class="label">Events</p><h2 class="h2">Convention Films</h2><p class="muted">The artists, the atmosphere and the moments that define an event.</p></div>
      <a href="/?for=convention#hire" class="btn ghost preset" data-for="convention">Book your convention</a>
    </div>
    <Carousel items={work.conventions} id="conv-track" ctaLine="Want your convention filmed?" cta="Book your convention" ctaFor="convention" />
  </section>

  {skits.length > 0 && (
    <section id="skits" class="section">
      <div class="sec-head wrap reveal">
        <div><p class="label">Comedy</p><h2 class="h2">Branded Skits</h2><p class="muted">Original comedy written and filmed for brands and events.</p></div>
        <a href="/?for=brand#hire" class="btn ghost preset" data-for="brand">Make one for your brand</a>
      </div>
      <Carousel items={skits} id="skit-track" ctaLine="Want a skit for your brand?" ctaFor="brand" />
    </section>
  )}

  <section class="clients wrap reveal">
    <p class="label center">Brands and events</p>
    <ul>{site.clients.map((c) => <li>{c}</li>)}</ul>
  </section>

  <section id="services" class="section wrap">
    <div class="sec-head reveal"><div><p class="label">Services</p><h2 class="h2">What I Can Make For You</h2><p class="muted">Clear scope and a clear quote before filming.</p></div></div>
    <div class="svc">
      {site.services.map((s) => (
        <a class="svc-row preset reveal" href={`/?for=${s.slug}#hire`} data-for={s.slug}>
          <div><h3>{s.name}</h3><p class="muted">{s.text}</p></div>
          <div class="svc-right"><span class="price">{s.price}</span><span class="go">Inquire →</span></div>
        </a>
      ))}
    </div>
  </section>

  <section id="hire" class="section hire">
    <div class="wrap">
      <div class="hire-head reveal">
        <p class="label center">Inquiries</p>
        <h2 class="h2">Hire Me</h2>
        <p class="muted">Tell me what you have in mind, where it happens and when you need it. I reply within two business days.</p>
      </div>
      <Inquiry />
    </div>
  </section>

  <dialog id="player" class="player">
    <div class="bar"><span id="p-title"></span><span><a id="p-link" target="_blank" rel="noopener">Watch on YouTube</a><button id="p-close" aria-label="Close">✕</button></span></div>
    <div class="box"><iframe id="p-frame" title="Film player" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('player') as HTMLDialogElement;
  const frame = document.getElementById('p-frame') as HTMLIFrameElement;
  const link = document.getElementById('p-link') as HTMLAnchorElement;
  document.querySelectorAll<HTMLButtonElement>('.poster').forEach((p) => p.addEventListener('click', () => {
    frame.src = p.dataset.src || ''; link.href = p.dataset.link || '#';
    link.textContent = (p.dataset.link || '').includes('vimeo') ? 'Watch on Vimeo' : 'Watch on YouTube';
    document.getElementById('p-title')!.textContent = p.dataset.title || ''; dlg.showModal();
  }));
  document.getElementById('p-close')?.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('close', () => { frame.src = 'about:blank'; });
  document.querySelectorAll<HTMLAnchorElement>('.preset').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('inquiry:preset', { detail: { type: a.dataset.for } }));
    document.getElementById('hire')?.scrollIntoView();
  }));
</script>

<style>
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; display: flex; align-items: flex-end; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 8%; animation: drift 18s ease-out both; }
  @keyframes drift { from { transform: scale(1.08); } to { transform: scale(1); } }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0) 45%, rgba(0,0,0,.9) 100%), linear-gradient(90deg, rgba(0,0,0,.55), transparent 60%); }
  .hero-text { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(4.5rem, 10vh, 7rem); animation: rise 1.4s .2s ease both; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  .hero .label { color: #cfc9bf; } .hero .label::after { background: #cfc9bf; }
  .hero h1 { font-size: clamp(3.6rem, 11vw, 9rem); font-weight: 400; line-height: .92; letter-spacing: -.01em; margin: 0 0 1rem; }
  .hero-line { font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-style: italic; max-width: 32rem; margin: 0 0 2rem; color: #e6e1d8; }
  .hero-ctas { display: flex; gap: .7rem; flex-wrap: wrap; }
  .scroll { position: absolute; z-index: 2; right: var(--pad); bottom: 2rem; display: grid; justify-items: center; gap: .5rem; font-family: var(--sans); font-size: .65rem; letter-spacing: .3em; text-transform: uppercase; color: #bbb; }
  .scroll i { width: 1px; height: 42px; background: linear-gradient(#fff, transparent); animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { opacity: .3; } 50% { opacity: 1; } }
  @media (max-width: 640px) { .scroll { display: none; } .hero-ctas .btn { flex: 1; text-align: center; padding-inline: .6rem; letter-spacing: .18em; } }

  .intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .hi { font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin: 0 0 1.2rem; }
  .lead { font-size: clamp(1.25rem, 2.2vw, 1.55rem); line-height: 1.45; margin: 0 0 1.2rem; }
  .reach { border-left: 1px solid var(--line); padding-left: clamp(1.5rem, 3vw, 3rem); }
  .big { font-size: clamp(3.4rem, 7vw, 5rem); line-height: 1; margin: 0; }
  .reach > .muted { margin: .2rem 0 1.6rem; }
  .reach ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .reach a { display: grid; }
  .reach span { font-size: 1.6rem; line-height: 1.1; }
  .reach small { font-family: var(--sans); font-size: .68rem; letter-spacing: .24em; text-transform: uppercase; color: var(--text-2); }
  .reach a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 820px) { .intro { grid-template-columns: 1fr; } .reach { border-left: 0; border-top: 1px solid var(--line); padding: 2rem 0 0; } }

  .center { justify-content: center; }
  .center::before { content: ''; width: 36px; height: 1px; background: #444; }
  .clients { text-align: center; padding-block: 1rem 2rem; }
  .clients ul { list-style: none; padding: 0; margin: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem 2.6rem; font-size: 1.3rem; font-style: italic; }
  .svc { border-top: 1px solid var(--line); }
  .svc-row { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; padding: 1.8rem .2rem; border-bottom: 1px solid var(--line); transition: background .3s; }
  .svc-row:hover { background: #080808; }
  .svc-row h3 { margin: 0 0 .3rem; font-size: 1.6rem; font-weight: 400; }
  .svc-row p { margin: 0; max-width: 44rem; }
  .svc-right { display: grid; justify-items: end; gap: .3rem; text-align: right; }
  .price { font-size: 1.15rem; white-space: nowrap; font-style: italic; }
  .go { font-family: var(--sans); font-size: .72rem; letter-spacing: .24em; text-transform: uppercase; color: var(--text-2); }
  .svc-row:hover .go { color: #fff; }
  @media (max-width: 640px) { .svc-row { grid-template-columns: 1fr; gap: .8rem; } .svc-right { justify-items: start; text-align: left; } }
  .hire { border-top: 1px solid var(--line); }
  .hire-head { text-align: center; margin-bottom: 2.5rem; }
  .hire-head .h2 { font-size: clamp(2.8rem, 7vw, 4.8rem); }
  .hire-head p.muted { max-width: 32rem; margin: .4rem auto 0; }
  .player { width: min(1100px, 94vw); padding: 0; border: 1px solid #333; background: #000; color: #fff; }
  .player::backdrop { background: rgba(0,0,0,.92); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .6rem 1rem; font-size: 1rem; }
  .bar a { font-family: var(--sans); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-2); margin-right: 1.2rem; }
  .bar a:hover { color: #fff; }
  .bar button { background: none; border: 0; color: #fff; font-size: 1.1rem; cursor: pointer; }
  .box { aspect-ratio: 16 / 9; } .box iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
