---
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import Inquiry from '../components/Inquiry.astro';
import site from '../data/site.json';
import work from '../data/work.json';
const skits = work.skits.filter((s: any) => s.vimeo);
---
<Base>
  <section class="hero wrap">
    <div class="hero-photo"><img src="/media/dakota-hero.jpg" alt="Dakota Weik on location in Buscalan, Philippines" width="1145" height="1431" fetchpriority="high" /></div>
    <div class="hero-text">
      <p class="eyebrow">Ethnographer and filmmaker</p>
      <h1>Films for tattoo conventions, artists, shops and brands.</h1>
      <p class="muted">I've filmed tattooing across the world for over six years, and 2.2 million people follow the work. Based in Philadelphia. Available worldwide.</p>
      <div class="hero-ctas"><a href="#hire" class="btn">Hire Me</a><a href="#films" class="btn ghost">Watch the films</a></div>
    </div>
  </section>

  <section id="films" class="section">
    <div class="sec-head wrap">
      <div><h2 class="h2">Artist Films</h2><p class="muted">From Life Beyond Ink, my original series on the world's greatest tattoo artists.</p></div>
      <a href={work.seriesLink} target="_blank" rel="noopener" class="btn ghost">Full series</a>
    </div>
    <Carousel items={work.films} id="films-track" ctaLine="Want a film like this about you?" ctaFor="artist" />
  </section>

  <section class="proof">
    <div class="wrap proof-in">
      <div class="reach">
        <p class="big">{site.totalFollowers}</p>
        <p class="muted">people follow my work</p>
      </div>
      <ul class="socials">
        {site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener"><strong>{s.followers}</strong><span class="muted">{s.label}</span></a></li>)}
      </ul>
      <div class="proof-cta">
        <p>Your film gets made by the same person who made these.</p>
        <a href="#hire" class="btn">Hire Me</a>
      </div>
    </div>
  </section>

  <section id="conventions" class="section">
    <div class="sec-head wrap">
      <div><h2 class="h2">Convention Films</h2><p class="muted">The artists, the atmosphere and the moments that define an event.</p></div>
      <a href="/?for=convention#hire" class="btn ghost preset" data-for="convention">Book your convention</a>
    </div>
    <Carousel items={work.conventions} id="conv-track" ctaLine="Want your convention filmed?" cta="Book your convention" ctaFor="convention" />
  </section>

  {skits.length > 0 && (
    <section id="skits" class="section">
      <div class="sec-head wrap">
        <div><h2 class="h2">Branded Skits</h2><p class="muted">Original comedy written and filmed for brands and events.</p></div>
        <a href="/?for=brand#hire" class="btn ghost preset" data-for="brand">Make one for your brand</a>
      </div>
      <Carousel items={skits} id="skit-track" ctaLine="Want a skit for your brand?" ctaFor="brand" />
    </section>
  )}

  <section class="clients wrap">
    <p class="muted label">Brands and events I've filmed for</p>
    <ul>{site.clients.map((c) => <li>{c}</li>)}</ul>
  </section>

  <section id="services" class="section wrap">
    <div class="sec-head"><div><h2 class="h2">What I Can Make For You</h2><p class="muted">Clear scope and a clear quote before filming.</p></div></div>
    <div class="svc">
      {site.services.map((s) => (
        <a class="svc-row preset" href={`/?for=${s.slug}#hire`} data-for={s.slug}>
          <div><h3>{s.name}</h3><p class="muted">{s.text}</p></div>
          <div class="svc-right"><span class="price">{s.price}</span><span class="go">Inquire →</span></div>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="section wrap about">
    <div>
      <h2 class="h2">About</h2>
      <p>I'm Dakota Weik, a tattoo ethnographer and filmmaker. I study and film tattooing across the world: the greatest tattoos, their artists, their history and their cultures. I'm also a tattoo artist.</p>
      <p>I create, write, direct and edit Life Beyond Ink and Indigenous Revival. Through Inked Abroad I also make films for conventions, artists, shops and brands, and you work with me directly from the first call to the final cut.</p>
      <a href="#hire" class="btn">Start a project</a>
    </div>
  </section>

  <section id="hire" class="section hire">
    <div class="wrap">
      <div class="hire-head">
        <h2 class="h2">Hire Me</h2>
        <p class="muted">Tell me what you have in mind, where it happens and when you need it. I reply within two business days.</p>
      </div>
      <Inquiry />
    </div>
  </section>

  <dialog id="player" class="player">
    <div class="bar"><span id="p-title"></span><span><a id="p-link" target="_blank" rel="noopener">Open in new tab</a><button id="p-close" aria-label="Close">✕</button></span></div>
    <div class="box"><iframe id="p-frame" title="Film player" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('player') as HTMLDialogElement;
  const frame = document.getElementById('p-frame') as HTMLIFrameElement;
  const link = document.getElementById('p-link') as HTMLAnchorElement;
  document.querySelectorAll<HTMLButtonElement>('.poster').forEach((p) => p.addEventListener('click', () => {
    frame.src = p.dataset.src || ''; link.href = p.dataset.link || '#';
    document.getElementById('p-title')!.textContent = p.dataset.title || ''; dlg.showModal();
  }));
  document.getElementById('p-close')?.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('close', () => { frame.src = 'about:blank'; });
  document.querySelectorAll<HTMLAnchorElement>('.preset').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('inquiry:preset', { detail: { type: a.dataset.for } }));
    document.getElementById('hire')?.scrollIntoView();
  }));
</script>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-block: 1.5rem 3rem; }
  .hero-photo img { width: 100%; height: min(82vh, 860px); object-fit: cover; object-position: 50% 30%; border-radius: 16px; }
  .eyebrow { font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; color: var(--text-2); margin: 0 0 1rem; }
  .hero h1 { font-size: clamp(2.2rem, 4.6vw, 4rem); line-height: 1.04; letter-spacing: -.03em; margin: 0 0 1.2rem; font-weight: 800; }
  .hero-text > p.muted { font-size: 1.1rem; max-width: 30rem; margin: 0 0 2rem; }
  .hero-ctas { display: flex; gap: .7rem; flex-wrap: wrap; }
  .hero-ctas .btn { padding: 1rem 2rem; font-size: 1rem; }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; padding-top: .5rem; } .hero-photo img { height: auto; aspect-ratio: 4 / 5; } }
  .pitch { text-align: center; color: var(--text-2); font-size: 1.05rem; margin: .6rem auto 0; }
  @media (max-width: 640px) { .br { display: none; } }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem 1.2rem; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 1.6rem .8rem; } }
  .proof { border-block: 1px solid var(--line); background: #0a0a0a; }
  .proof-in { display: grid; grid-template-columns: auto 1fr auto; gap: 2.5rem; align-items: center; padding-block: 2.5rem; }
  .big { font-size: clamp(2.6rem, 6vw, 3.6rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin: 0; }
  .reach p { margin: 0; }
  .socials { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .socials a { display: grid; }
  .socials strong { font-size: 1.4rem; }
  .socials a:hover strong { text-decoration: underline; }
  .proof-cta { text-align: right; }
  .proof-cta p { margin: 0 0 .8rem; font-size: .95rem; max-width: 16rem; margin-left: auto; }
  @media (max-width: 900px) { .proof-in { grid-template-columns: 1fr; text-align: center; gap: 1.6rem; } .proof-cta { text-align: center; } .proof-cta p { margin: 0 auto .8rem; } }
  @media (max-width: 520px) { .socials { grid-template-columns: repeat(2, 1fr); } }
  .clients { text-align: center; padding-top: 1rem; }
  .label { font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 1rem; }
  .clients ul { list-style: none; padding: 0; margin: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: .6rem 2.4rem; font-weight: 600; font-size: 1.05rem; }
  .svc { border-top: 1px solid var(--line); }
  .svc-row { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; padding: 1.5rem .2rem; border-bottom: 1px solid var(--line); transition: background .2s; }
  .svc-row:hover { background: #0d0d0d; }
  .svc-row h3 { margin: 0 0 .3rem; font-size: 1.2rem; }
  .svc-row p { margin: 0; max-width: 46rem; }
  .svc-right { display: grid; justify-items: end; gap: .2rem; text-align: right; }
  .price { font-weight: 700; white-space: nowrap; }
  .go { font-size: .9rem; color: var(--text-2); }
  .svc-row:hover .go { color: #fff; }
  @media (max-width: 640px) { .svc-row { grid-template-columns: 1fr; gap: .8rem; } .svc-right { justify-items: start; text-align: left; } }
  .about { max-width: 820px; }
  .about img { border-radius: 14px; aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .about p { color: #ccc; max-width: 36rem; }
  .about .btn { margin-top: .6rem; }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } }
  .hire { background: #0a0a0a; border-top: 1px solid var(--line); }
  .hire-head { text-align: center; margin-bottom: 2rem; }
  .hire-head .h2 { font-size: clamp(2rem, 5vw, 3rem); }
  .hire-head p { max-width: 32rem; margin: .5rem auto 0; }
  .player { width: min(1100px, 94vw); padding: 0; border: 0; border-radius: 12px; overflow: hidden; background: #000; color: #fff; }
  .player::backdrop { background: rgba(0,0,0,.9); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .6rem 1rem; font-size: .9rem; }
  .bar a { color: var(--text-2); margin-right: 1rem; text-decoration: underline; }
  .bar button { background: none; border: 0; color: #fff; font-size: 1.1rem; cursor: pointer; }
  .box { aspect-ratio: 16 / 9; } .box iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
