---
import Base from '../layouts/Base.astro';
import Skyline from '../components/Skyline.astro';
import Inquiry from '../components/Inquiry.astro';
import site from '../data/site.json';
import work from '../data/work.json';
const vimeoParts = (v: string) => { const m = v.match(/(\d+)(?:\/([0-9a-f]+))?/); return m ? { id: m[1], h: m[2] || '' } : null; };
const sections = work.sections
  .map((s: any) => ({ ...s, items: s.items.filter((i: any) => i.youtube || i.vimeo) }))
  .filter((s: any) => s.items.length);
const embed = (i: any) => {
  if (i.youtube) return `https://www.youtube-nocookie.com/embed/${i.youtube}?autoplay=1&rel=0`;
  const v = vimeoParts(i.vimeo); return v ? `https://player.vimeo.com/video/${v.id}?autoplay=1${v.h ? `&h=${v.h}` : ''}` : '';
};
const poster = (i: any) => i.poster || (i.youtube ? `https://i.ytimg.com/vi/${i.youtube}/maxresdefault.jpg` : '');
---
<Base>
  <section class="hero">
    <div class="hero-frame">
      <p class="deco kicker">{site.title}</p>
      <h1 class="display name">Dakota<br />Weik</h1>
      <div class="orn"><span></span></div>
      <p class="lede">Convention films, artist films, promos and branded comedy for clients in Philadelphia and around the world.</p>
      <div class="ctas">
        <a href="#work" class="btn">See the work</a>
        <a href="#inquire" class="btn primary">Start a project</a>
      </div>
    </div>
    <div class="sky"><Skyline /></div>
  </section>

  <section class="reach">
    <div class="wrap">
      <p class="label total"><span class="display">{site.totalFollowers}</span> followers across Inked Abroad</p>
      <ul class="socials">
        {site.socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener"><span class="display num">{s.followers}</span><span class="deco plat">{s.label}</span><span class="muted handle">{s.handle}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="clients wrap">
    <p class="label">Selected clients</p>
    <ul>{site.clients.map((c) => <li class="deco">{c}</li>)}</ul>
  </section>

  <section id="work" class="section wrap">
    <div class="heading"><div class="orn"><span></span></div><h2 class="display">Selected Work</h2><p>Films for events, artists, businesses and brands.</p></div>
    {sections.map((s: any) => (
      <div class="group">
        <div class="group-head"><h3 class="display">{s.title}</h3><p class="muted">{s.line}</p></div>
        <div class:list={['grid', { vertical: s.vertical }]}>
          {s.items.map((i: any) => (
            <button class="card" data-src={embed(i)} data-title={i.title} aria-label={`Play ${i.title}`}>
              <div class="poster frame-deco">
                {poster(i)
                  ? <img src={poster(i)} alt="" loading="lazy" decoding="async" onerror="if(!this.dataset.f){this.dataset.f=1;this.src=this.src.replace('maxresdefault','hqdefault')}" />
                  : <div class="titlecard"><span class="display">{i.title}</span></div>}
                <span class="play" aria-hidden="true">▶</span>
              </div>
              <span class="c-title display">{i.title}</span>
              <span class="c-meta">{i.sub}{i.runtime && ` · ${i.runtime}`}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
    <p class="center"><a class="btn" href={work.seriesLink} target="_blank" rel="noopener">Watch the full Life Beyond Ink series</a></p>
  </section>

  <section id="services" class="section services">
    <div class="wrap">
      <div class="heading"><div class="orn"><span></span></div><h2 class="display">What I Can Make For You</h2><p>Every project includes an agreed scope and a clear quote before filming.</p></div>
      <div class="svc-grid">
        {site.services.map((s) => (
          <div class="svc frame-deco">
            <h3 class="display">{s.name}</h3>
            <p class="price deco">{s.price}</p>
            <p>{s.text}</p>
            {s.note && <p class="muted small">{s.note}</p>}
            <a href={`/?for=${s.slug === 'business' ? 'business' : s.slug}#inquire`} class="btn svc-btn" data-for={s.slug}>{s.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap about">
    <div class="photo frame-deco"><img src="/media/dakota.jpg" alt="Dakota Weik on location in the Philippines" loading="lazy" /></div>
    <div>
      <div class="orn left"><span></span></div>
      <h2 class="display">The Person Behind the Films</h2>
      <p>I'm Dakota Weik, a tattoo ethnographer and filmmaker based in Philadelphia. I study and film tattoo artists, histories and cultures around the world. I'm also a tattoo artist.</p>
      <p>Inked Abroad is my solo creative studio. I create, write, direct and edit Life Beyond Ink and Indigenous Revival, alongside commissioned films for conventions, artists, businesses and brands.</p>
      <p>When you hire Inked Abroad, you work directly with me from the first conversation through the finished film.</p>
    </div>
  </section>

  <section id="inquire" class="section inquire">
    <div class="wrap">
      <div class="heading"><div class="orn"><span></span></div><h2 class="display">Tell Me About Your Project</h2><p>A few details are enough to get started. Tell me what you have in mind, where it will happen and when you need it. I'll reply within two business days.</p></div>
      <Inquiry />
    </div>
  </section>

  <dialog id="player" class="player">
    <div class="player-bar"><span id="player-title" class="deco"></span><button id="player-close" class="btn">Close</button></div>
    <div class="player-box"><iframe id="player-frame" title="Film player" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('player') as HTMLDialogElement;
  const frame = document.getElementById('player-frame') as HTMLIFrameElement;
  const ttl = document.getElementById('player-title')!;
  document.querySelectorAll<HTMLButtonElement>('.card').forEach((c) => c.addEventListener('click', () => {
    frame.src = c.dataset.src || ''; ttl.textContent = c.dataset.title || ''; dlg.showModal();
  }));
  const close = () => { dlg.close(); };
  document.getElementById('player-close')?.addEventListener('click', close);
  dlg.addEventListener('close', () => { frame.src = 'about:blank'; });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  document.querySelectorAll<HTMLAnchorElement>('.svc-btn').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    const map: Record<string, string> = { convention: 'convention', artist: 'artist', business: 'business', brand: 'brand' };
    document.dispatchEvent(new CustomEvent('inquiry:preset', { detail: { type: map[a.dataset.for || ''] } }));
    document.getElementById('inquire')?.scrollIntoView();
  }));
</script>

<style>
  .hero { position: relative; overflow: hidden; text-align: center; padding-top: clamp(3rem, 8vw, 6rem); background: radial-gradient(ellipse at 50% 100%, #2a2112 0%, var(--bg) 60%); }
  .hero-frame { position: relative; z-index: 2; max-width: 860px; margin: 0 auto; padding: 0 var(--pad); }
  .kicker { color: var(--gold); font-size: .9rem; font-weight: 700; }
  .name { font-size: clamp(4.2rem, 14vw, 10rem); color: var(--gold-2); margin: 1.2rem 0 1.4rem; text-shadow: 0 0 30px rgba(201,164,92,.18); }
  .lede { font-size: 1.2rem; color: var(--text); max-width: 34rem; margin: 1rem auto 2rem; }
  .ctas { display: flex; justify-content: center; flex-wrap: wrap; gap: .8rem; }
  .sky { color: var(--gold); margin-top: clamp(1rem, 4vw, 3rem); }
  .sky :global(svg) { width: 100%; height: auto; display: block; }
  .reach { border-top: 1px solid rgba(201,164,92,.35); border-bottom: 1px solid rgba(201,164,92,.35); background: var(--bg-2); padding: 2.2rem 0; text-align: center; }
  .total { margin: 0 0 1.4rem; }
  .total .display { font-size: 1.6rem; color: var(--gold-2); letter-spacing: .05em; margin-right: .4rem; vertical-align: -2px; }
  .socials { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .socials li + li { border-left: 1px solid rgba(201,164,92,.25); }
  .socials a { display: grid; gap: .2rem; padding: .5rem; transition: color .2s; }
  .socials a:hover .num { color: var(--gold); }
  .num { font-size: clamp(1.8rem, 4vw, 2.8rem); color: var(--gold-2); }
  .plat { font-size: .78rem; font-weight: 700; color: var(--gold); }
  .handle { font-size: .85rem; }
  @media (max-width: 640px) { .socials { grid-template-columns: 1fr 1fr; row-gap: 1.2rem; } .socials li:nth-child(3) { border-left: 0; } }
  .clients { text-align: center; padding-top: 3rem; }
  .clients ul { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 2.4rem; }
  .clients li { font-size: .95rem; font-weight: 700; color: var(--text-2); }
  .group { margin-bottom: 4.5rem; }
  .group-head { border-bottom: 1px solid rgba(201,164,92,.35); padding-bottom: .9rem; margin-bottom: 1.8rem; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .group-head h3 { font-size: clamp(1.7rem, 3.5vw, 2.4rem); color: var(--gold-2); }
  .group-head p { margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2.4rem 1.8rem; }
  .grid.vertical { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .card { background: none; border: 0; padding: 0; text-align: left; color: inherit; cursor: pointer; display: grid; gap: .45rem; font: inherit; }
  .poster { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface); margin-bottom: .6rem; }
  .vertical .poster { aspect-ratio: 9 / 16; }
  .poster img { width: 100%; height: 100%; object-fit: cover; filter: sepia(.25) contrast(1.05); transition: transform 1s, filter .4s; }
  .card:hover img { transform: scale(1.04); filter: none; }
  .titlecard { position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem; text-align: center; background: radial-gradient(circle, #241d10, var(--surface)); }
  .titlecard .display { font-size: 1.6rem; color: var(--gold-2); }
  .play { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 58px; height: 58px; border-radius: 50%; border: 1px solid var(--gold-2); display: grid; place-items: center; color: var(--gold-2); background: rgba(11,10,8,.55); font-size: 1.1rem; padding-left: 4px; opacity: .85; transition: opacity .3s, background .3s; }
  .card:hover .play { background: var(--gold); color: var(--bg); opacity: 1; }
  .c-title { font-size: 1.3rem; color: var(--text); line-height: 1.15; }
  .c-meta { font-size: .9rem; color: var(--text-2); }
  .center { text-align: center; margin-top: 1rem; }
  .services { background: var(--bg-2); border-top: 1px solid rgba(201,164,92,.3); border-bottom: 1px solid rgba(201,164,92,.3); }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem; }
  .svc { padding: 2rem 1.6rem; display: flex; flex-direction: column; gap: .4rem; background: var(--bg); }
  .svc h3 { font-size: 1.7rem; color: var(--gold-2); }
  .price { color: var(--gold); font-weight: 700; font-size: .85rem; margin: .4rem 0; }
  .svc p { margin: 0 0 .6rem; }
  .svc .btn { margin-top: auto; align-self: flex-start; font-size: .72rem; padding: .8rem 1.1rem; }
  .small { font-size: .92rem; }
  .about { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .photo { aspect-ratio: 4 / 5; overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; filter: sepia(.2); }
  .about h2 { font-size: clamp(2rem, 4.5vw, 3.2rem); color: var(--gold-2); margin-bottom: 1.4rem; }
  .orn.left { justify-content: flex-start; } .orn.left::before { display: none; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } }
  .inquire { background: radial-gradient(ellipse at 50% 0%, #241d10 0%, var(--bg) 65%); }
  .player { width: min(1100px, 94vw); padding: 0; border: 1px solid var(--gold); background: var(--bg); color: var(--text); }
  .player::backdrop { background: rgba(0,0,0,.85); }
  .player-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .7rem 1rem; }
  .player-bar .deco { font-size: .8rem; font-weight: 700; color: var(--gold-2); }
  .player-bar .btn { padding: .5rem .9rem; font-size: .7rem; }
  .player-box { aspect-ratio: 16 / 9; } .player-box iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
