---
import Base from '../layouts/Base.astro';
import FilmTile from '../components/FilmTile.astro';
import Inquiry from '../components/Inquiry.astro';
import site from '../data/site.json';
import { films } from '../data/films';
const filming = [
  ['Tattoo artists', 'Your process, your work, your story.'],
  ['Tattoo shops', 'Shop films, artist features, guest spots and flash days.'],
  ['Local businesses', 'Restaurants, bars, coffee shops, gyms and makers.'],
  ['Conventions', 'Full weekend coverage, hosting and recaps.'],
];
---
<Base>
  <section class="hero">
    {site.heroVideo
      ? <video class="hero-media" src={site.heroVideo} poster={site.heroImage || undefined} autoplay muted loop playsinline aria-hidden="true"></video>
      : site.heroImage && <img class="hero-media" src={site.heroImage} alt="" fetchpriority="high" />}
    <div class="hero-shade"></div>
    <div class="wrap hero-inner">
      <p class="label">{site.title} · {site.city}</p>
      <h1 class="display hero-title">{site.name}</h1>
      <div class="hero-ctas">
        <a href="#work" class="btn">See the work</a>
        <a href="#inquire" class="btn primary">Inquire</a>
      </div>
    </div>
  </section>

  <section id="work" class="section wrap">
    <p class="label"><span class="num">01</span>Work</p>
    <div class="grid">
      {films.map((f) => <FilmTile film={f} />)}
    </div>
  </section>

  <section class="section wrap">
    <p class="label"><span class="num">02</span>What I film</p>
    <ul class="what">
      {filming.map(([t, d]) => <li><span class="display">{t}</span><span class="muted">{d}</span></li>)}
    </ul>
  </section>

  <section id="inquire" class="section inquire">
    <div class="wrap">
      <p class="label"><span class="num">03</span>Inquire</p>
      <h2 class="display h2">Let's film something.</h2>
      <Inquiry />
    </div>
  </section>
</Base>

<style>
  html { scroll-behavior: smooth; }
  .hero { position: relative; min-height: calc(85svh - 72px); display: flex; align-items: flex-end; overflow: hidden; }
  .hero-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,16,16,.1) 0%, rgba(16,16,16,.9) 100%); }
  .hero-inner { position: relative; width: 100%; padding-bottom: clamp(3rem, 8vw, 6rem); }
  .hero-title { font-size: clamp(4rem, 13vw, 12rem); margin: 1rem 0 2rem; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: .75rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem 2.5rem; margin-top: 2.5rem; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
  .what { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border-top: 1px solid #2c2c2c; }
  .what li { display: grid; gap: .5rem; padding: 1.75rem 1.5rem 1.75rem 0; border-bottom: 1px solid #2c2c2c; }
  .what .display { font-size: 2.2rem; }
  .inquire { background: var(--bg-2); }
  .h2 { font-size: clamp(2.8rem, 7vw, 6rem); margin: 1rem 0 2.5rem; }
  .inquire :global(input), .inquire :global(select), .inquire :global(textarea) { background: var(--bg); }
</style>
