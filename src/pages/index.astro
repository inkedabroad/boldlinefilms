---
import Base from '../layouts/Base.astro';
import Inquiry from '../components/Inquiry.astro';
import Ornament from '../components/Ornament.astro';
import site from '../data/site.json';
import { featured, selected, relatedTo, stillOf } from '../data/work';
const f: any = featured;
const related = relatedTo(featured);
const clients = ['Dr. Pickles', 'EZ Tattoo', 'A Pound of Flesh'];
const [lead, ...rest] = site.services;
const cardImg = (p: any) => p.card || stillOf(p);
---
<Base>
  <section class="lead wrap" aria-labelledby="who">
    <figure class="face">
      <div class="frame"><img src="/media/dakota-hero.jpg" alt="Dakota Weik" width="1145" height="1431" fetchpriority="high" /></div>
      <figcaption class="meta capline">Dakota Weik in Buscalan, Philippines.</figcaption>
    </figure>
    <div class="intro">
      <p class="kicker">Tattoo ethnographer and filmmaker</p>
      <h1 id="who" class="h-display name">Dakota Weik</h1>
      <p class="deck">I make films for tattoo conventions, artists, independent businesses and brands. Based in Philadelphia and available worldwide.</p>
      <div class="actions"><a href="#inquire" class="btn">Start a project</a><a href="#work" class="link">See the work</a></div>
    </div>
  </section>

  <section class="wrap feature" aria-label="Featured film">
    <hr class="rule" />
    <figure class="lead-fig">
      <a href={`/work/${f.slug}/`} class="frame" aria-label={`Watch ${f.title}`}>
        <picture>
          {f.stillMobile && <source media="(max-width: 760px)" srcset={f.stillMobile} width="700" height="525" />}
          <img src={f.still} alt={`${f.event}, from the film ${f.title}`} width={f.stillW || 980} height={f.stillH || 445} loading="lazy" />
        </picture>
      </a>
      <figcaption class="cap">
        <span class="tag">{f.label}</span>
        <span class="cap-title">{f.event}</span>
        <span class="meta">{[f.place, f.runtime].filter(Boolean).join(' · ')}</span>
        <a href={`/work/${f.slug}/`} class="link">Watch the film</a>
      </figcaption>
      {related.length > 0 && (
        <p class="rel meta">Also from this event: {related.map((r, i) => <>{i > 0 && ', '}<a href={`/work/${r.slug}/`}>{r.title}</a> ({r.label.toLowerCase()})</>)}</p>
      )}
    </figure>
  </section>

  <section id="work" class="section wrap">
    <div class="sec-head"><h2 class="h-section">Selected work</h2></div>
    <hr class="rule" />
    <div class="grid">
      {selected.map((p: any) => (
        <article class="card">
          <a href={`/work/${p.slug}/`} class="card-img"><img src={cardImg(p)} alt={p.caption || `Still from ${p.title}`} loading="lazy" decoding="async" width="576" height="720" /></a>
          <p class="tag">{p.label}</p>
          <h3 class="card-title"><a href={`/work/${p.slug}/`}>{p.title}</a></h3>
          <p class="meta">{p.made}{p.role && `. ${p.role}.`}</p>
        </article>
      ))}
    </div>
    <p class="clients"><span class="tag">Selected clients</span> {clients.join(' · ')}</p>
  </section>

  <section id="services" class="wrap">
    <div class="ad">
      <h2 class="h-section ad-head">Work with me</h2>
      <div class="ad-lead">
        <h3 class="h-display ad-lead-title">{lead.name}</h3>
        <div>
          <p>Weekend film coverage, a cinematic recap and social edits. Hosting and Nikon F2 photography can be included in the agreed scope.</p>
          <a href="/?for=convention#inquire" class="btn preset" data-for="convention">Discuss your convention</a>
        </div>
      </div>
      <ul class="ad-list">
        {rest.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <a href={`/?for=${s.slug}#inquire`} class="link preset" data-for={s.slug}>Inquire</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="about" class="section wrap about">
    <h2 class="h-section">About Dakota</h2>
    <p class="about-copy">I’m Dakota Weik, a tattoo ethnographer and filmmaker based in Philadelphia. I study tattooing around the world and practice it myself. Through Inked Abroad, I make commissioned films and create the original series Life Beyond Ink and Indigenous Revival. When you hire Inked Abroad, you work directly with me.</p>
  </section>

  <section id="inquire" class="wrap">
    <div class="paper-form">
      <Ornament width={90} class="form-orn" />
      <h2 class="h-section">Tell me about your project</h2>
      <p class="muted form-intro">I reply within two business days.</p>
      <Inquiry />
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.preset').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('inquiry:preset', { detail: { type: a.dataset.for } }));
    document.getElementById('inquire')?.scrollIntoView();
  }));
</script>

<style>
  .lead { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; padding-block: clamp(1.4rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem); }
  .name { font-size: clamp(40px, 5.6vw, 84px); margin-bottom: .9rem; }
  .deck { font-style: italic; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.5; color: var(--ink); margin: 0 0 1.5rem; max-width: 26rem; }
  .actions { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  .lead-fig { margin: 0; }
  .face { margin: 0; }
  .face img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .capline { margin-top: .5rem; font-style: italic; font-family: var(--serif); }
  .name { font-size: clamp(44px, 6.4vw, 92px) !important; }
  .feature { padding-bottom: var(--space); }
  .feature .rule { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .ad-lead-title { font-size: clamp(32px, 3.6vw, 48px); color: var(--green); }
  .frame { display: block; border: 1px solid var(--ink); padding: 7px; background: var(--paper-2); outline: 1px solid var(--rule); outline-offset: 5px; }
  .frame img { width: 100%; height: auto; }
  .cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem 1rem; margin-top: 1.1rem; padding-top: .7rem; border-top: 1px solid var(--rule); }
  .cap-title { font-family: var(--display); font-weight: 600; font-size: clamp(24px, 2.4vw, 32px); line-height: 1.1; }
  .cap .link { margin-left: auto; }
  .rel { margin: .6rem 0 0; } .rel a { color: var(--ink); }
  @media (max-width: 860px) {
    .lead { grid-template-columns: 1fr; gap: 1.4rem; padding-top: 1.2rem; }

    .cap .link { margin-left: 0; flex-basis: 100%; }
    .frame { padding: 5px; outline-offset: 3px; }
  }
  .sec-head { margin-bottom: .9rem; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3.5vw, 3rem); margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
  .card-img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #1b1a16; margin-bottom: .9rem; }
  .card-img img { width: 100%; height: 100%; object-fit: cover; }
  .card .tag { margin: 0 0 .25rem; }
  .card-title { font-family: var(--display); font-weight: 600; font-size: clamp(27px, 2.5vw, 34px); line-height: 1.08; margin: 0 0 .3rem; }
  .card-title a { text-decoration: none; }
  .card-title a:hover { color: var(--red); }
  .card .meta { margin: 0; }
  .clients { margin: clamp(2rem, 4vw, 3rem) 0 0; padding-top: 1rem; border-top: 1px solid var(--rule); font-style: italic; font-size: 18px; text-align: center; }
  .clients .tag { font-style: normal; margin-right: .6rem; }

  .ad { border: 1px solid var(--ink); outline: 1px solid var(--rule); outline-offset: 5px; background: var(--paper-2); padding: clamp(1.4rem, 4vw, 3rem); }
  .ad-head { text-align: center; padding-bottom: 1rem; border-bottom: 3px double var(--ink); }
  .ad-lead { display: grid; grid-template-columns: 1fr 1.4fr; gap: 1.5rem 3rem; align-items: center; padding: clamp(1.5rem, 3vw, 2.5rem) 0; border-bottom: 1px solid var(--rule); }
  .ad-lead .kicker { font-size: 1.25rem; }
  .price { font-size: clamp(38px, 4.6vw, 60px); color: var(--green); }
  .ad-lead p:not(.kicker):not(.price) { margin: 0 0 1.2rem; max-width: 34rem; }
  .ad-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem 2rem; padding-top: clamp(1.4rem, 3vw, 2rem); }
  .ad-list h3 { font-family: var(--display); font-weight: 600; font-size: 26px; line-height: 1.1; margin: 0 0 .4rem; }
  .ad-list p { margin: 0 0 .7rem; font-size: 17px; }
  @media (max-width: 860px) { .ad-lead, .ad-list { grid-template-columns: 1fr; } .ad-lead .btn { width: 100%; text-align: center; } }

  .about { max-width: 820px; text-align: center; }
  .about figure { margin: 0; }
  .about img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--ink); padding: 6px; background: var(--paper-2); }
  .about figcaption { margin-top: .5rem; font-style: italic; font-family: var(--serif); }
  .about-copy { font-size: clamp(19px, 1.6vw, 22px); line-height: 1.6; margin: 1rem auto 0; }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } .about figure { max-width: 420px; } }

  .paper-form { background: var(--paper-3); border-top: 3px solid var(--green); padding: clamp(1.4rem, 5vw, 3.5rem); max-width: 760px; margin: 0 auto; }
  .paper-form :global(.form-orn) { margin: 0 0 .6rem; }
  .form-intro { margin: .4rem 0 1.6rem; }
</style>
