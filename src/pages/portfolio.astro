---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import VideoCard from '../components/VideoCard.astro';
import { portfolio, vimeoEmbed } from '../data/films';
const videos = portfolio.filter((film) => vimeoEmbed(film));
---
<Base title="Portfolio">
  <PageHead title="Portfolio" />
  <div class="videos">{videos.map((film) => <VideoCard film={film} />)}</div>
  <p class="cta"><a class="button" href="/contact/">Contact me</a></p>
</Base>
<style>
  .videos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3rem) clamp(1.2rem, 3vw, 2.4rem); }
  .videos:has(> :only-child) { grid-template-columns: minmax(0, 900px); justify-content: center; }
  @media (max-width: 760px) { .videos { grid-template-columns: minmax(0, 1fr); } }
  .cta { text-align: center; margin: clamp(2.5rem, 6vw, 4rem) 0 0; }
</style>
