---
import Base from '../../layouts/Base.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import FilmTile from '../../components/FilmTile.astro';
import { films } from '../../data/films';

export function getStaticPaths() {
  return films.map((film) => ({ params: { slug: film.slug }, props: { film } }));
}
const { film } = Astro.props;
const idx = films.findIndex((f) => f.slug === film.slug);
const next = films[(idx + 1) % films.length];
const typeLabel = { commissioned: 'Commissioned', original: 'Original film', spec: 'Spec project', collaboration: 'Collaboration' }[film.projectType as string];
const details = [
  ['Client', film.client], ['Category', film.categories.join(', ')], ['Year', film.year],
  ['Location', film.location], ['Length', film.duration], ['Role', film.roles], ['Project', typeLabel],
].filter(([, v]) => v);
const hasVideo = film.video?.provider && film.video?.id;
---
<Base title={`${film.title}${film.client ? ` for ${film.client}` : ''} | Dakota Weik`} description={film.synopsis || `${film.title}, a film by Dakota Weik.`}>
  <article>
    <section class="wrap head">
      <p class="label"><span class="num">Film</span>{film.categories[0]} · {film.year}</p>
      <h1 class="display h1">{film.title}</h1>
      {film.client && <p class="client">for {film.client}</p>}
    </section>

    <section class="wrap media">
      {hasVideo
        ? <VideoPlayer film={film} />
        : <div class="frame">{film.poster ? <img src={film.poster} alt={`Still from ${film.title}`} /> : <div class="titlecard"><span class="display">{film.title}</span></div>}</div>}
      {film.externalUrl && <p class="ext"><a class="btn primary" href={film.externalUrl} target="_blank" rel="noopener">Watch the series</a></p>}
    </section>

    <section class="wrap body">
      <dl class="details">
        {details.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="story">
        {film.synopsis && <p class="lead">{film.synopsis}</p>}
        {film.objective && (<><h2 class="label">The story</h2><p>{film.objective}</p></>)}
        {film.approach && (<><h2 class="label">Production approach</h2><p>{film.approach}</p></>)}
        {film.deliverables?.length > 0 && (<><h2 class="label">Delivered</h2><ul>{film.deliverables.map((d: string) => <li>{d}</li>)}</ul></>)}
        {film.testimonial && (<blockquote><p>“{film.testimonial.quote}”</p><cite class="label">{film.testimonial.name}</cite></blockquote>)}
      </div>
    </section>

    {film.stills?.length > 0 && (
      <section class="wrap stills">
        {film.stills.map((s: string) => <img src={s} alt={`Still from ${film.title}`} loading="lazy" />)}
      </section>
    )}

    <section class="section cta">
      <div class="wrap">
        <h2 class="display cta-title">Want something like this?</h2>
        <a href="/#inquire" class="btn primary">Inquire</a>
      </div>
    </section>

    {next && next.slug !== film.slug && (
      <section class="section wrap">
        <p class="label" style="margin-bottom:1.5rem">Next film</p>
        <FilmTile film={next} size="large" />
      </section>
    )}
  </article>
</Base>

<style>
  .head { padding-top: clamp(3rem, 8vw, 6rem); padding-bottom: 2rem; }
  .h1 { font-size: clamp(3.5rem, 10vw, 9rem); margin-top: 1rem; }
  .client { color: var(--text-2); font-size: 1.2rem; margin: .5rem 0 0; }
  .ext { margin-top: 1.5rem; }
  .body { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; padding-top: 4rem; padding-bottom: 2rem; }
  .details { margin: 0; display: grid; gap: 1.25rem; align-content: start; }
  .details dd { margin: .25rem 0 0; }
  .story { max-width: 42rem; }
  .story h2 { margin: 2.5rem 0 .75rem; font-weight: 400; }
  .lead { font-size: 1.35rem; line-height: 1.5; margin-top: 0; }
  blockquote { margin: 3rem 0 0; padding-left: 1.5rem; border-left: 2px solid var(--accent); font-size: 1.25rem; }
  .stills { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-top: 3rem; }
  .cta { background: var(--bg-2); margin-top: 4rem; }
  .cta-title { font-size: clamp(2.5rem, 6vw, 5rem); margin-bottom: 2rem; }
  @media (max-width: 820px) { .body { grid-template-columns: 1fr; } .stills { grid-template-columns: 1fr; } }
</style>
