---
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import { projects, relatedTo, stillOf, inquiryType, type Project } from '../../data/work';
export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props as { project: Project };
const p: any = project;
const related = relatedTo(project);
const idx = projects.findIndex((x) => x.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
const t = inquiryType(project);
const ctaLabel = t === 'convention' ? 'Discuss your convention' : 'Start a project';
const credits = [['Role', p.role], ['Location', p.place], ['Runtime', p.runtime]].filter(([, v]) => v);
---
<Base compact title={`${p.title} | Dakota Weik`} description={p.synopsis || `${p.title}, a film by Dakota Weik.`} image={p.still && p.still.startsWith('/') ? p.still : undefined}>
  <article class="wrap page">
    <a href="/#work" class="back meta">← All work</a>
    <p class="tag">{p.label}</p>
    <h1 class="h-display title">{p.title}</h1>
    {p.event && p.event !== p.title && <p class="client">{p.event}</p>}
    <Player project={project} />
    {p.caption && <p class="caption meta">{p.caption}</p>}
    <div class="body">
      <div>
        {p.synopsis && <p class="desc">{p.synopsis}</p>}
      </div>
      <dl>
        {credits.map(([k, v]) => <div><dt class="tag">{k}</dt><dd>{v}</dd></div>)}
        {p.deliverables?.length > 0 && <div><dt class="tag">Delivered</dt><dd>{p.deliverables.join(', ')}</dd></div>}
      </dl>
    </div>
    {related.length > 0 && (
      <section class="related">
        <h2 class="h-section small">From the same event</h2>
        <div class="rel-grid">{related.map((r) => <a href={`/work/${r.slug}/`}><img src={stillOf(r)} alt="" loading="lazy" /><span class="tag">{r.label}</span><span class="rel-title">{r.title}</span></a>)}</div>
      </section>
    )}
    <section class="cta">
      <h2 class="h-section">Want a film like this?</h2>
      <a href={`/?for=${t}&project=${p.slug}#inquire`} class="btn">{ctaLabel}</a>
    </section>
    {next && next.slug !== p.slug && (
      <p class="next"><span class="tag">Next film</span> <a href={`/work/${next.slug}/`}>{next.title}</a></p>
    )}
  </article>
</Base>
<style>
  .page { padding-top: 1.2rem; max-width: calc(1000px + var(--gut) * 2); }
  .back { display: inline-block; text-decoration: none; margin-bottom: 1.4rem; font-weight: 600; }
  .back:hover { color: var(--red); }
  .title { font-size: clamp(36px, 5.4vw, 64px); margin: .3rem 0 .2rem; }
  .client { font-style: italic; font-size: 20px; color: var(--ink-2); margin: 0 0 1.4rem; }
  .caption { margin: .7rem 0 0; font-style: italic; font-family: var(--serif); }
  .body { display: grid; grid-template-columns: 1.5fr 1fr; gap: 2.5rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .desc { font-size: clamp(19px, 1.6vw, 22px); line-height: 1.55; margin: 0; }
  dl { margin: 0; display: grid; gap: .9rem; }
  dd { margin: .15rem 0 0; }
  @media (max-width: 760px) { .body { grid-template-columns: 1fr; gap: 1.5rem; } }
  .related { margin-top: 3rem; }
  .small { font-size: clamp(26px, 2.6vw, 34px); margin-bottom: 1rem; }
  .rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.4rem; }
  .rel-grid a { display: grid; gap: .3rem; text-decoration: none; }
  .rel-grid img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .rel-title { font-family: var(--display); font-weight: 600; font-size: 24px; }
  .cta { margin-top: 3rem; padding: 2rem 0; border-top: 3px double var(--ink); border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
  @media (max-width: 640px) { .cta .btn { width: 100%; text-align: center; } }
  .next { margin: 1.6rem 0 0; }
  .next a { font-family: var(--display); font-weight: 600; font-size: 24px; text-decoration: none; border-bottom: 1.5px solid var(--red); }
</style>
