---
import '@fontsource/league-gothic';
import '@fontsource-variable/inter';
import '../../styles/global.css';
const groups = [['local-business', 'Local Business'], ['tattoo-shops', 'Tattoo Shop'], ['tattoo-artists', 'Tattoo Artist'], ['conventions', 'Convention'], ['brands', 'Brand']];
const packages = ['Brand Audit', 'Studio', 'Studio Plus', 'Monthly Content Session', 'Convention Film Package', 'Director & Cinematographer Day', 'Undecided'];
const statuses = ['lead', 'pitched', 'client', 'paused'];
const fields = [
  ['business_type', 'What they are', 'Cocktail bar, coffee roaster, tattoo shop...'],
  ['location', 'Location', 'Fishtown, Philadelphia'],
  ['website', 'Website', ''],
  ['instagram', 'Instagram', '@handle'],
  ['contact', 'Contact & approver', 'Name, role, email'],
  ['goals', 'Their goals', 'More private event bookings, weekday traffic...'],
  ['audience', 'Who they want to reach', ''],
  ['offers', 'Signature products, services, people', 'Dishes, drinks, artists, the owner...'],
  ['current_social', 'What their social looks like now', 'Posting rhythm, quality, what works'],
  ['competitors', 'Competitors', ''],
  ['brand_look', 'Brand look & feel', 'Colors, vibe, references'],
  ['notes', 'Other notes', ''],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Studio HQ</title>
</head>
<body>
  <div id="login" class="wrap login">
    <h1 class="display">Studio HQ</h1>
    <form id="login-form">
      <input id="pw" type="password" placeholder="Password" autocomplete="current-password" required />
      <button class="btn primary">Enter</button>
      <p id="login-err" class="err"></p>
    </form>
  </div>

  <div id="app" class="app" hidden>
    <aside class="side">
      <div class="side-head"><span class="display">Studio HQ</span><button id="new-client" class="btn small">+ Client</button></div>
      <ul id="client-list"></ul>
    </aside>

    <main class="main">
      <section id="empty" class="pad"><p class="muted">Pick a client or add a new one.</p></section>

      <section id="editor" class="pad" hidden>
        <form id="client-form">
          <input type="hidden" name="id" />
          <div class="row3">
            <label>Business name<input name="name" required /></label>
            <label>Group<select name="group_type">{groups.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
            <label>Status<select name="status">{statuses.map((s) => <option>{s}</option>)}</select></label>
          </div>
          <label>Package<select name="package">{packages.map((p) => <option>{p}</option>)}</select></label>
          <div class="grid2">
            {fields.map(([k, l, ph]) => (
              <label>{l}<textarea name={`p_${k}`} rows="2" placeholder={ph}></textarea></label>
            ))}
          </div>
          <button class="btn">Save client</button> <span id="save-msg" class="muted small"></span>
        </form>

        <div id="gen" class="gen" hidden>
          <h2 class="display">Build a plan</h2>
          <label>Extra direction for this plan (optional)<textarea id="gen-notes" rows="2" placeholder="Launching brunch in March, push private events..."></textarea></label>
          <div class="btns">
            <button class="btn primary" data-kind="strategy">Audit & Strategy</button>
            <button class="btn" data-kind="calendar">Content Calendar</button>
            <button class="btn" data-kind="proposal">Proposal Email</button>
          </div>
        </div>

        <div id="plans"></div>
      </section>
    </main>
  </div>

  <div id="viewer" class="viewer" hidden>
    <div class="viewer-bar">
      <button id="v-close" class="btn small">Close</button>
      <button id="v-copy" class="btn small">Copy text</button>
      <button id="v-print" class="btn small primary">Save as PDF</button>
      <span id="v-status" class="muted small"></span>
    </div>
    <article id="doc" class="doc"></article>
  </div>

<script>
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  let key = sessionStorage.getItem('hq') || '';
  let clients: any[] = [];
  let current: any = null;
  let viewerText = '';

  async function api(path: string, opts: RequestInit = {}) {
    const res = await fetch(`/hq/api/${path}`, { ...opts, headers: { 'x-hq-key': key, 'content-type': 'application/json', ...(opts.headers || {}) } });
    if (res.status === 401) { sessionStorage.removeItem('hq'); location.reload(); throw new Error('auth'); }
    if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || `Error ${res.status}`);
    return res;
  }

  function esc(s: string) { return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string)); }
  function inline(s: string) { return esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<em>$1</em>'); }
  function md(src: string) {
    const out: string[] = []; let list = ''; let table: string[][] = [];
    const flushList = () => { if (list) { out.push(`<${list}>`), out.push(...pending), out.push(`</${list}>`); list = ''; pending = []; } };
    let pending: string[] = [];
    const flushTable = () => {
      if (!table.length) return;
      const rows = table.filter((r) => !r.every((c) => /^:?-{2,}:?$/.test(c.trim())));
      out.push('<table><thead><tr>' + rows[0].map((c) => `<th>${inline(c.trim())}</th>`).join('') + '</tr></thead><tbody>' +
        rows.slice(1).map((r) => '<tr>' + r.map((c) => `<td>${inline(c.trim())}</td>`).join('') + '</tr>').join('') + '</tbody></table>');
      table = [];
    };
    for (const line of src.split('\n')) {
      if (/^\s*\|.*\|\s*$/.test(line)) { flushList(); table.push(line.trim().slice(1, -1).split('|')); continue; }
      flushTable();
      let m;
      if ((m = line.match(/^(#{1,3})\s+(.*)/))) { flushList(); out.push(`<h${m[1].length}>${inline(m[2])}</h${m[1].length}>`); }
      else if ((m = line.match(/^\s*[-*]\s+(.*)/))) { if (list !== 'ul') { flushList(); list = 'ul'; } pending.push(`<li>${inline(m[1])}</li>`); }
      else if ((m = line.match(/^\s*\d+\.\s+(.*)/))) { if (list !== 'ol') { flushList(); list = 'ol'; } pending.push(`<li>${inline(m[1])}</li>`); }
      else if (line.trim()) { flushList(); out.push(`<p>${inline(line)}</p>`); }
      else flushList();
    }
    flushList(); flushTable();
    return out.join('\n');
  }

  async function loadClients() {
    clients = await (await api('clients')).json();
    const ul = $('#client-list');
    ul.innerHTML = clients.map((c) => `<li><button data-id="${c.id}" class="${current?.id === c.id ? 'on' : ''}"><strong>${esc(c.name)}</strong><span>${esc(c.status)} · ${esc(c.package || '')}</span></button></li>`).join('') || '<li class="muted small pad-s">No clients yet.</li>';
    ul.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => openClient(clients.find((c) => c.id === (b as HTMLElement).dataset.id))));
  }

  function openClient(c: any) {
    current = c;
    $('#empty').hidden = true; $('#editor').hidden = false; $('#gen').hidden = !c;
    const f = $('#client-form') as HTMLFormElement;
    f.reset();
    (f.elements.namedItem('id') as HTMLInputElement).value = c?.id || '';
    if (c) {
      (f.elements.namedItem('name') as HTMLInputElement).value = c.name;
      (f.elements.namedItem('group_type') as HTMLSelectElement).value = c.group_type;
      (f.elements.namedItem('status') as HTMLSelectElement).value = c.status;
      (f.elements.namedItem('package') as HTMLSelectElement).value = c.package || 'Undecided';
      for (const [k, v] of Object.entries(c.profile || {})) { const el = f.elements.namedItem(`p_${k}`) as HTMLTextAreaElement; if (el) el.value = String(v); }
      loadPlans();
    } else $('#plans').innerHTML = '';
    loadClients();
  }

  async function loadPlans() {
    const plans = await (await api(`plans?client=${current.id}`)).json();
    $('#plans').innerHTML = plans.length ? '<h2 class="display">Saved plans</h2>' + plans.map((p: any, i: number) =>
      `<button class="plan" data-i="${i}"><strong>${esc(p.title || p.kind)}</strong><span>${new Date(p.created_at).toLocaleString()}</span></button>`).join('') : '';
    $('#plans').querySelectorAll('.plan').forEach((b) => b.addEventListener('click', () => showDoc(plans[Number((b as HTMLElement).dataset.i)].content, 'Saved')));
  }

  function showDoc(text: string, status = '') {
    viewerText = text; $('#doc').innerHTML = md(text); $('#v-status').textContent = status; $('#viewer').hidden = false;
  }

  $('#login-form').addEventListener('submit', async (e) => {
    e.preventDefault(); key = ($('#pw') as HTMLInputElement).value;
    try { await api('login', { method: 'POST' }); sessionStorage.setItem('hq', key); start(); }
    catch { $('#login-err').textContent = 'Wrong password, or HQ is not set up yet.'; }
  });

  $('#new-client').addEventListener('click', () => openClient(null));

  $('#client-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement; const fd = new FormData(f); const profile: Record<string, string> = {};
    for (const [k, v] of fd.entries()) if (k.startsWith('p_') && String(v).trim()) profile[k.slice(2)] = String(v).trim();
    const body = { id: fd.get('id') || undefined, name: fd.get('name'), group_type: fd.get('group_type'), status: fd.get('status'), package: fd.get('package'), profile };
    try { const saved = await (await api('clients', { method: 'POST', body: JSON.stringify(body) })).json(); $('#save-msg').textContent = 'Saved'; openClient(saved); }
    catch (err) { $('#save-msg').textContent = (err as Error).message; }
  });

  document.querySelectorAll<HTMLButtonElement>('#gen [data-kind]').forEach((b) => b.addEventListener('click', async () => {
    if (!current) return;
    showDoc('', 'Writing...');
    let text = '';
    try {
      const res = await api('generate', { method: 'POST', body: JSON.stringify({ clientId: current.id, kind: b.dataset.kind, notes: ($('#gen-notes') as HTMLTextAreaElement).value }) });
      const reader = res.body!.getReader(); const dec = new TextDecoder();
      for (;;) { const { done, value } = await reader.read(); if (done) break; text += dec.decode(value, { stream: true }); viewerText = text; $('#doc').innerHTML = md(text); }
      $('#v-status').textContent = 'Saved to this client'; loadPlans();
    } catch (err) { $('#v-status').textContent = (err as Error).message; }
  }));

  $('#v-close').addEventListener('click', () => ($('#viewer').hidden = true));
  $('#v-copy').addEventListener('click', async () => { await navigator.clipboard.writeText(viewerText); $('#v-status').textContent = 'Copied'; });
  $('#v-print').addEventListener('click', () => window.print());

  async function start() { $('#login').hidden = true; $('#app').hidden = false; await loadClients(); }
  if (key) api('login', { method: 'POST' }).then(start).catch(() => {});
</script>

<style is:global>
  .login { max-width: 420px; padding-top: 18vh; }
  .login h1 { font-size: 5rem; margin-bottom: 1.5rem; }
  .login form { display: grid; gap: .75rem; }
  .err { color: #e2694f; min-height: 1.2em; }
  input, select, textarea { background: var(--bg-2); border: 1px solid #2f2f2f; color: var(--text); padding: .75rem .9rem; font: 400 .95rem var(--body); width: 100%; border-radius: 0; }
  label { display: grid; gap: .35rem; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-2); }
  .app { display: grid; grid-template-columns: 280px 1fr; min-height: 100vh; }
  .side { border-right: 1px solid #222; background: #0c0c0c; }
  .side-head { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border-bottom: 1px solid #222; }
  .side-head .display { font-size: 1.8rem; }
  .btn.small { padding: .5rem .8rem; font-size: .68rem; }
  #client-list { list-style: none; margin: 0; padding: 0; }
  #client-list button, .plan { display: grid; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid #1c1c1c; color: var(--text); padding: .9rem 1.25rem; cursor: pointer; font: inherit; }
  #client-list button span, .plan span { color: var(--text-2); font-size: .8rem; }
  #client-list button.on, #client-list button:hover, .plan:hover { background: var(--bg-2); }
  .pad { padding: 2rem; max-width: 1100px; }
  .pad-s { padding: 1rem 1.25rem; }
  .small { font-size: .85rem; }
  #client-form { display: grid; gap: 1rem; }
  #client-form > .btn { justify-self: start; }
  .row3 { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 1rem; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .gen { margin-top: 3rem; display: grid; gap: 1rem; padding-top: 2rem; border-top: 1px solid #222; }
  .gen h2, #plans h2 { font-size: 2.4rem; }
  .btns { display: flex; flex-wrap: wrap; gap: .6rem; }
  #plans { margin-top: 3rem; }
  .plan { border: 1px solid #222; margin-top: .5rem; }
  .viewer { position: fixed; inset: 0; background: #e9e6df; overflow: auto; z-index: 100; }
  .viewer-bar { position: sticky; top: 0; display: flex; gap: .5rem; align-items: center; padding: .75rem 1rem; background: var(--bg); }
  .doc { max-width: 820px; margin: 2rem auto 4rem; background: #fff; color: #1b1b1b; padding: 3.5rem 4rem; font: 400 1rem/1.65 var(--body); box-shadow: 0 10px 40px rgba(0,0,0,.15); }
  .doc h1 { font: 400 3rem/1 var(--display); text-transform: uppercase; margin: 0 0 1.5rem; border-bottom: 3px solid var(--accent); padding-bottom: 1rem; }
  .doc h2 { font: 400 1.9rem/1.1 var(--display); text-transform: uppercase; margin: 2.2rem 0 .6rem; color: var(--accent); }
  .doc h3 { font-size: 1.05rem; margin: 1.4rem 0 .4rem; }
  .doc table { border-collapse: collapse; width: 100%; font-size: .85rem; margin: 1rem 0; }
  .doc th, .doc td { border: 1px solid #ddd; padding: .45rem .55rem; vertical-align: top; text-align: left; }
  .doc th { background: #f3f0ea; }
  @media (max-width: 860px) { .app { grid-template-columns: 1fr; } .row3, .grid2 { grid-template-columns: 1fr; } .doc { padding: 2rem 1.5rem; } }
  @media print {
    body { background: #fff; }
    #app, #login, .viewer-bar { display: none !important; }
    .viewer { position: static; background: #fff; overflow: visible; }
    .doc { box-shadow: none; margin: 0; padding: 0; max-width: none; }
    .doc h2 { break-after: avoid; }
  }
</style>
</body>
</html>
